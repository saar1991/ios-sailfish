diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index af65255..69e7dfc 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -522,6 +522,78 @@ AppleCLCD::startScaled(void)
  * whose logical (nearest) pixel is inside it. Source rows are read once into
  * fRow (the surface mapping is write-combined: slow to read piecemeal).
  */
+/*
+ * 0218: a rectangle across two icons went black for one frame at the end
+ * of a page swipe (video 22:57 at 1:42.9, about 120 s uptime), with no
+ * error in the shim's log. Look for such a rectangle in every presented
+ * frame before it is scaled to the panel: on every 8th row, runs of 140 or
+ * more black pixels (B, G and R under 8) with non-black pixels at both
+ * ends, on 3 or more sampled rows in a row. Logged (at most 60, from 45 s,
+ * after the startup black wallpaper) with the swap number and time: if the
+ * presented picture holds it, CA or the shim drew it; if never, the kernel's
+ * copy to the panel made it.
+ */
+static void
+sweet_fb_black_scan(uintptr_t src, uint32_t bpr, int32_t sx, int32_t sy, int32_t w, int32_t h, uint32_t swap,
+    uint32_t id)
+{
+	static uint32_t logged;
+	if (logged >= 60 || w < 160 || h < 24) {
+		return;
+	}
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	if (ns < 45ull * NSEC_PER_SEC) {
+		return;
+	}
+	int32_t rows = 0, y0 = -1, x0 = 0, x1 = 0, ry0 = 0;
+	for (int32_t y = 0; y < h; y += 8) {
+		const uint8_t *row = (const uint8_t *)(src + (uint64_t)(sy + y) * bpr + (uint64_t)sx * 4);
+		int32_t best0 = -1, best1 = -1;
+		for (int32_t x = 1; x < w - 1;) {
+			const uint8_t *p = row + x * 4;
+			if (p[0] < 8 && p[1] < 8 && p[2] < 8) {
+				int32_t start = x;
+				while (x < w - 1 && row[x * 4] < 8 && row[x * 4 + 1] < 8 && row[x * 4 + 2] < 8) {
+					x++;
+				}
+				const uint8_t *before = row + (start - 1) * 4;
+				bool bounded = x < w - 1 && (before[0] >= 8 || before[1] >= 8 || before[2] >= 8);
+				if (bounded && x - start >= 140 && x - start > best1 - best0) {
+					best0 = start;
+					best1 = x;
+				}
+			} else {
+				x++;
+			}
+		}
+		if (best0 >= 0) {
+			if (rows == 0) {
+				ry0 = y;
+				x0 = best0;
+				x1 = best1;
+			} else {
+				x0 = MIN(x0, best0);
+				x1 = MAX(x1, best1);
+			}
+			rows++;
+			y0 = y;
+		} else if (rows > 0) {
+			if (rows >= 3) {
+				logged++;
+				IOLog("SWEET BLACK: %llu ms swap %u surface %u: black x %d-%d y %d-%d (%d sampled rows)\n",
+				    (unsigned long long)(ns / 1000000), swap, id, x0, x1, ry0, y0 + 7, rows);
+			}
+			rows = 0;
+		}
+	}
+	if (rows >= 3) {
+		logged++;
+		IOLog("SWEET BLACK: %llu ms swap %u surface %u: black x %d-%d y %d-%d (%d sampled rows)\n",
+		    (unsigned long long)(ns / 1000000), swap, id, x0, x1, ry0, y0 + 7, rows);
+	}
+}
+
 void
 AppleCLCD::blitScaled(uintptr_t src, uint32_t bpr, int32_t sx, int32_t sy,
     int32_t dx, int32_t dy, int32_t w, int32_t h)
@@ -1014,6 +1086,7 @@ AppleCLCD::present(const uint8_t *rec)
 				}
 			}
 		} else if (src != 0 && bpe == 4 && fScaled) {
+			sweet_fb_black_scan(src + s->offset, s->bytesPerRow, sx, sy, w, h, get32(rec, 0x50), id);
 			/* not over the frame the DSI is still sending (0210) */
 			sweet_fbcon_wait_idle();
 			blitScaled(src + s->offset, s->bytesPerRow, sx, sy, dx, dy, w, h);
