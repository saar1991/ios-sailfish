 static int perf_sleep_chan;
 
+/*
+ * 0218: what keep launchd and mediaserverd busy? They use about 63% and
+ * 45% of a core all the time, even with the phone idle (SWEET TOP), and no
+ * crash loop explains it. Count the system calls of the processes named in
+ * boot-arg sweetsys (default "launchd,mediaserverd", at most two, "-" = off):
+ * BSD syscalls and Mach traps, with how many failed and the last error.
+ * Every 10 s from 20 s to 400 s: "SWEET SYS: <s> s <name>[pid] 10 s: N bsd,
+ * M mach; ..." then the 12 most frequent, 4 per line, as name xCOUNT
+ * (eFAILED last ERR). The hooks (bsd/dev/arm/systemcalls.c,
+ * osfmk/arm64/bsd_arm64.c) only compare current_task() with sweet_sys_task.
+ */
+#define SWEET_SYS_BSD   576
+#define SWEET_SYS_MACH  128
+void *sweet_sys_task[2];
+static uint32_t sweet_sys_n[2][2][SWEET_SYS_BSD], sweet_sys_err[2][2][SWEET_SYS_BSD];
+static int32_t sweet_sys_last[2][2][SWEET_SYS_BSD];
+static char sweet_sys_names[64];
+static char sweet_sys_name[2][32];
+static int sweet_sys_pid[2];
+extern const char *syscallnames[];
+extern const unsigned int nsysent;
+extern const char * const mach_syscall_name_table[];
+extern task_t proc_task(proc_t);
+
+void sweet_sys_count(int which, int bsd, int num, int err);
+void
+sweet_sys_count(int which, int bsd, int num, int err)
+{
+	if (num < 0 || num >= (bsd ? SWEET_SYS_BSD : SWEET_SYS_MACH)) {
+		return;
+	}
+	sweet_sys_n[which][bsd][num]++;
+	if (err != 0) {
+		sweet_sys_err[which][bsd][num]++;
+		sweet_sys_last[which][bsd][num] = err;
+	}
+}
+
+static int
+sweet_sys_find(proc_t p, __unused void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	for (int i = 0; i < 2; i++) {
+		if (sweet_sys_name[i][0] != 0 && strcmp(name, sweet_sys_name[i]) == 0) {
+			sweet_sys_pid[i] = proc_pid(p);
+			sweet_sys_task[i] = proc_task(p);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+sweet_sys_report(uint64_t up)
+{
+	static bool init;
+	if (!init) {
+		init = true;
+		if (!PE_parse_boot_argn("sweetsys", sweet_sys_names, sizeof(sweet_sys_names))) {
+			strlcpy(sweet_sys_names, "launchd,mediaserverd", sizeof(sweet_sys_names));
+		}
+		if (sweet_sys_names[0] != '-') {
+			char *comma = strchr(sweet_sys_names, ',');
+			size_t l0 = comma ? (size_t)(comma - sweet_sys_names) : strlen(sweet_sys_names);
+			strlcpy(sweet_sys_name[0], sweet_sys_names, MIN(l0 + 1, sizeof(sweet_sys_name[0])));
+			if (comma) {
+				strlcpy(sweet_sys_name[1], comma + 1, sizeof(sweet_sys_name[1]));
+			}
+		}
+	}
+	if (sweet_sys_name[0][0] == 0) {
+		return;
+	}
+	for (int w = 0; w < 2; w++) {
+		if (sweet_sys_name[w][0] == 0 || sweet_sys_task[w] == NULL) {
+			continue;
+		}
+		/* static: 14 KB, too much for a kernel stack; only the perf thread calls this */
+		static uint32_t n[2][SWEET_SYS_BSD], e[2][SWEET_SYS_BSD];
+		static int32_t last[2][SWEET_SYS_BSD];
+		uint64_t tot[2] = {0, 0};
+		for (int b = 0; b < 2; b++) {
+			for (int i = 0; i < SWEET_SYS_BSD; i++) {
+				n[b][i] = sweet_sys_n[w][b][i];
+				e[b][i] = sweet_sys_err[w][b][i];
+				last[b][i] = sweet_sys_last[w][b][i];
+				sweet_sys_n[w][b][i] = sweet_sys_err[w][b][i] = 0;
+				tot[b] += n[b][i];
+			}
+		}
+		printf("SWEET SYS: %llu s %s[%d] 10 s: %llu bsd, %llu mach\n", (unsigned long long)up, sweet_sys_name[w],
+		    sweet_sys_pid[w], (unsigned long long)tot[1], (unsigned long long)tot[0]);
+		char line[240];
+		int m = 0;
+		for (int k = 0; k < 12; k++) {
+			int bb = -1, bi = -1;
+			for (int b = 0; b < 2; b++) {
+				for (int i = 0; i < SWEET_SYS_BSD; i++) {
+					if (n[b][i] > 0 && (bb < 0 || n[b][i] > n[bb][bi])) {
+						bb = b;
+						bi = i;
+					}
+				}
+			}
+			if (bb < 0) {
+				break;
+			}
+			const char *nm = bb ? ((unsigned)bi < nsysent ? syscallnames[bi] : "?") : mach_syscall_name_table[bi];
+			m += snprintf(line + m, sizeof(line) - m, " %s%s x%u", bb ? "" : "mach:", nm ? nm : "?", n[bb][bi]);
+			if (e[bb][bi] > 0 && bb) {
+				m += snprintf(line + m, sizeof(line) - m, " (e%u last %d)", e[bb][bi], last[bb][bi]);
+			} else if (e[bb][bi] > 0) {
+				m += snprintf(line + m, sizeof(line) - m, " (e%u last 0x%x)", e[bb][bi], (uint32_t)last[bb][bi]);
+			}
+			n[bb][bi] = 0;
+			if (k % 4 == 3 || m > 170) {
+				printf("SWEET SYS:%s\n", line);
+				m = 0;
+				line[0] = 0;
+			}
+		}
+		if (m > 0) {
+			printf("SWEET SYS:%s\n", line);
+		}
+	}
+	/* the processes may restart: look them up again */
+	proc_iterate(PROC_ALLPROCLIST, sweet_sys_find, NULL, NULL, NULL);
+}
+
