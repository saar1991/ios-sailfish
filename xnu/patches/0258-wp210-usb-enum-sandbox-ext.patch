+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("SWEET Sandbox: %s consumes an extension (handle %lld)\n", name, (long long)h);
+	}
+	return copyout(&h, (user_addr_t)a[2], sizeof(h));
+}
