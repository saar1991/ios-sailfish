 /*
- * 0257: USB, step 1 for the WP210 (MTU3, Linux drivers/usb/mtu3), read only:
- * the state LK's fastboot leaves the controller in, wp210usbprobe=SECS after
- * the keys start (default 230, after the scripted test; 0 = off). The MAC
- * (0x11201000) and IPPC (0x11203e00) are read only when pericfg_ao
- * (0x11036000) + 0x40 bit 10 (peraop_1_usb_sys, 1 = gated) says the clock is
- * on: a gated block may hang the read.
+ * WP210 USB (MTU3 device controller, Linux drivers/usb/mtu3).
+ * 0257 (log 522c92d3) showed LK leaves it in device mode: clocks on, host
+ * port powered down, device powered (IPPC PW_CTRL1 1 / CTRL2 0), VBUS valid
+ * (OTG_STS bit 9), host-given address 24 in DEVICE_CONF, but the D+ pull-up
+ * off (POWER_MANAGEMENT SOFT_CONN 0). So the gadget below needs no clock,
+ * PHY or reset work: it reconnects and answers the host itself.
+ *
+ * 0258, step 2: enumeration as a CDC NCM device (VID 0525 PID a4a1, the
+ * Linux NCM gadget's IDs; IAD so Windows' usbccgp gives the function to
+ * UsbNcm.sys), ep0 by PIO polled from a thread, every SETUP logged. Bulk
+ * endpoints are configured (PIO, nothing queued, so they NAK); when the host
+ * selects data alt 1 the interrupt endpoint reports "connected" at 480
+ * Mbit/s. No packets yet (step 3). wp210usb=SECS after the keys start
+ * (default 25; 0 = off: the controller is then only read, as in 0257).
  */
+static vm_offset_t wp210_umac, wp210_uippc;
+#define UMR(o) (*(volatile uint32_t *)(wp210_umac + (o)))
+#define UIR(o) (*(volatile uint32_t *)(wp210_uippc + 0xe00 + (o)))
+
+static void
+wp210_usb_dump(const char *when)
+{
+	static const uint16_t ip[] = {0x00, 0x04, 0x08, 0x0c, 0x10, 0x14, 0x18, 0x24, 0x28, 0x2c, 0x30, 0x40, 0x50,
+	    0x8c, 0x98, 0xa0, 0xa4};
+	static const uint16_t mr[] = {0x000, 0x004, 0x080, 0x084, 0x100, 0x108, 0x400, 0x404, 0xc04, 0xc08, 0xc0c,
+	    0xc10, 0xc84, 0x800, 0x804, 0x850, 0x854, 0x1410, 0x1534, 0x2404, 0x240c, 0x2418, 0x241c, 0x2424, 0x243c,
+	    0x244c, 0x2460};
+	char line[400];
+	int n = snprintf(line, sizeof(line), "SWEET USB: wp210 %s IPPC", when);
+	for (unsigned i = 0; i < sizeof(ip) / sizeof(ip[0]); i++) {
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %02x=%08x", ip[i], UIR(ip[i]));
+	}
+	printf("%s\n", line);
+	n = snprintf(line, sizeof(line), "SWEET USB: wp210 %s MAC", when);
+	for (unsigned i = 0; i < sizeof(mr) / sizeof(mr[0]); i++) {
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %x=%x", mr[i], UMR(mr[i]));
+		if (n > 340) {
+			printf("%s\n", line);
+			n = snprintf(line, sizeof(line), "SWEET USB: wp210 %s MAC", when);
+		}
+	}
+	printf("%s\n", line);
+}
+
+/* MTU3 registers (mtu3_hw_regs.h) */
+#define U_LV1ISR        0x000
+#define U_EPISR         0x080
+#define U_EPIESR        0x088
+#define U_EP0CSR        0x100
+#define U_RXCOUNT0      0x108
+#define U_TXCSR0(n)     (0x110 + ((n) - 1) * 0x10)
+#define U_TXCSR1(n)     (0x114 + ((n) - 1) * 0x10)
+#define U_TXCSR2(n)     (0x118 + ((n) - 1) * 0x10)
+#define U_RXCSR0(n)     (0x210 + ((n) - 1) * 0x10)
+#define U_RXCSR1(n)     (0x214 + ((n) - 1) * 0x10)
+#define U_RXCSR2(n)     (0x218 + ((n) - 1) * 0x10)
+#define U_FIFO(n)       (0x300 + (n) * 0x10)
+#define U_DEVICE_CONF   0x800
+#define U_EP_RST        0x804
+#define U_LINK_INTR_EN  0x850
+#define U_LINK_INTR     0x854
+#define U_USB3_CONFIG   0x141c
+#define U_POWER_MGMT    0x2404
+#define U_COMMON_INTR_EN 0x2418
+#define U_COMMON_INTR   0x241c
+#define U_LINK_RESET_INFO 0x2424
+
+#define EP0_SENDSTALL   (1u << 25)
+#define EP0_FIFOFULL    (1u << 23)
+#define EP0_SENTSTALL   (1u << 22)
+#define EP0_DPHTX       (1u << 20)
+#define EP0_DATAEND     (1u << 19)
+#define EP0_TXPKTRDY    (1u << 18)
+#define EP0_SETUPPKTRDY (1u << 17)
+#define EP0_RXPKTRDY    (1u << 16)
+#define EP0_W1C         (~(EP0_RXPKTRDY | EP0_SETUPPKTRDY | EP0_SENTSTALL))
+#define SOFT_CONN       (1u << 6)
+#define HS_ENABLE       (1u << 5)
+#define SUSPENDM_ENABLE (1u << 0)
+
+static const uint8_t wp210_ud_dev[18] = {
+	18, 1, 0x00, 0x02, 0xef, 0x02, 0x01, 64, 0x25, 0x05, 0xa1, 0xa4, 0x58, 0x02, 1, 2, 3, 1,
+};
+static const uint8_t wp210_ud_qual[10] = {10, 6, 0x00, 0x02, 0xef, 0x02, 0x01, 64, 1, 0};
+static const uint8_t wp210_ud_cfg[94] = {
+	9, 2, 94, 0, 2, 1, 0, 0xc0, 50,
+	8, 0x0b, 0, 2, 0x02, 0x0d, 0, 0,                  /* IAD: interfaces 0-1, CDC NCM */
+	9, 4, 0, 0, 1, 0x02, 0x0d, 0, 4,                  /* communication interface */
+	5, 0x24, 0x00, 0x10, 0x01,                        /* CDC header 1.10 */
+	5, 0x24, 0x06, 0, 1,                              /* union: master 0, slave 1 */
+	13, 0x24, 0x0f, 5, 0, 0, 0, 0, 0xea, 0x05, 0, 0, 0, /* Ethernet: MAC string 5, 1514 */
+	6, 0x24, 0x1a, 0x00, 0x01, 0x00,                  /* NCM 1.0 */
+	7, 5, 0x81, 3, 16, 0, 9,                          /* notifications, 32 ms */
+	9, 4, 1, 0, 0, 0x0a, 0, 1, 0,                     /* data, alt 0: no endpoints */
+	9, 4, 1, 1, 2, 0x0a, 0, 1, 0,                     /* data, alt 1 */
+	7, 5, 0x82, 2, 0x00, 0x02, 0,                     /* bulk IN 512 */
+	7, 5, 0x02, 2, 0x00, 0x02, 0,                     /* bulk OUT 512 */
+};
+static const uint8_t wp210_ud_ntb[28] = {
+	28, 0, 1, 0, 0x00, 0x40, 0, 0, 4, 0, 0, 0, 4, 0, 0, 0, 0x00, 0x40, 0, 0, 4, 0, 0, 0, 4, 0, 0, 0,
+};
+static const char *const wp210_ud_str[] = {
+	NULL, "Sailfish", "WP210 iOS (CDC NCM)", "WP210-0258", "CDC NCM", "02D0E2100001",
+};
+
+static struct {
+	int state;              /* 0 setup, 1 data IN, 2 data OUT, 3 IN done */
+	uint8_t buf[256];
+	unsigned len, off, zlp;
+	unsigned rxlen;
+	uint8_t config, alt, addr, speed, notify;
+	unsigned setups, resets, logged;
+} wp210_ud;
+
+static void
+wp210_ud_fifo_write(unsigned ep, const uint8_t *src, unsigned len)
+{
+	volatile uint8_t *f = (volatile uint8_t *)(wp210_umac + U_FIFO(ep));
+	unsigned i = 0;
+	for (; i + 4 <= len; i += 4) {
+		uint32_t w;
+		memcpy(&w, src + i, 4);
+		*(volatile uint32_t *)f = w;
+	}
+	if (len - i >= 2) {
+		uint16_t h;
+		memcpy(&h, src + i, 2);
+		*(volatile uint16_t *)f = h;
+		i += 2;
+	}
+	if (i < len) {
+		*f = src[i];
+	}
+}
+
+static void
+wp210_ud_fifo_read(uint8_t *dst, unsigned len)
+{
+	unsigned i = 0;
+	for (; i < len; i += 4) {
+		uint32_t w = UMR(U_FIFO(0));
+		memcpy(dst + i, &w, len - i < 4 ? len - i : 4);
+	}
+}
+
+static void
+wp210_ud_tx(void)
+{
+	unsigned cnt = wp210_ud.len - wp210_ud.off;
+	if (cnt > 64) {
+		cnt = 64;
+	}
+	if (cnt) {
+		wp210_ud_fifo_write(0, wp210_ud.buf + wp210_ud.off, cnt);
+	}
+	wp210_ud.off += cnt;
+	if (cnt < 64 || (wp210_ud.off == wp210_ud.len && !wp210_ud.zlp)) {
+		wp210_ud.state = 3;
+	} else if (wp210_ud.off == wp210_ud.len) {
+		wp210_ud.zlp = 0;       /* a zero-length packet follows */
+	}
+	UMR(U_EP0CSR) = (UMR(U_EP0CSR) & EP0_W1C) | EP0_TXPKTRDY;
+}
+
+static void
+wp210_ud_config_eps(void)
+{
+	/* EP reset, then TX1 interrupt 16 (fifo 0), TX2 bulk 512 (fifo 512), RX2 bulk 512 (fifo 0); PIO, slot 0 */
+	UMR(U_EP_RST) = (1u << 17) | (1u << 18) | (1u << 2);
+	UMR(U_EP_RST) = 0;
+	UMR(U_TXCSR0(1)) = 16;
+	UMR(U_TXCSR1(1)) = 1u << 4;
+	UMR(U_TXCSR2(1)) = (9u << 24) | (9u << 16) | (0u >> 4);
+	UMR(U_TXCSR0(2)) = 512;
+	UMR(U_TXCSR1(2)) = 0;
+	UMR(U_TXCSR2(2)) = (9u << 16) | (512u >> 4);
+	UMR(U_RXCSR0(2)) = 512;
+	UMR(U_RXCSR1(2)) = 0;
+	UMR(U_RXCSR2(2)) = (9u << 16) | 0;
+	printf("SWEET USB: wp210 endpoints: TX1 %#x/%#x/%#x TX2 %#x/%#x/%#x RX2 %#x/%#x/%#x\n",
+	    UMR(U_TXCSR0(1)), UMR(U_TXCSR1(1)), UMR(U_TXCSR2(1)), UMR(U_TXCSR0(2)), UMR(U_TXCSR1(2)),
+	    UMR(U_TXCSR2(2)), UMR(U_RXCSR0(2)), UMR(U_RXCSR1(2)), UMR(U_RXCSR2(2)));
+}
+
+/* returns 1 = handled with data IN prepared, 2 = OUT data expected, 0 = no data, -1 = stall */
+static int
+wp210_ud_request(const uint8_t *st)
+{
+	unsigned type = st[0], req = st[1], val = st[2] | (st[3] << 8), idx = st[4] | (st[5] << 8);
+	unsigned wlen = st[6] | (st[7] << 8);
+	const uint8_t *d = NULL;
+	unsigned dl = 0;
+	uint8_t tmp[64];
+
+	if ((type & 0x60) == 0x00) {
+		switch (req) {
+		case 6:                 /* GET_DESCRIPTOR */
+			switch (val >> 8) {
+			case 1: d = wp210_ud_dev; dl = sizeof(wp210_ud_dev); break;
+			case 2: d = wp210_ud_cfg; dl = sizeof(wp210_ud_cfg); break;
+			case 6: d = wp210_ud_qual; dl = sizeof(wp210_ud_qual); break;
+			case 3:
+				if ((val & 0xff) == 0) {
+					tmp[0] = 4; tmp[1] = 3; tmp[2] = 0x09; tmp[3] = 0x04;
+					d = tmp; dl = 4;
+				} else if ((val & 0xff) < sizeof(wp210_ud_str) / sizeof(wp210_ud_str[0])) {
+					const char *s = wp210_ud_str[val & 0xff];
+					unsigned n = 0;
+					for (; s[n] && n < 30; n++) {
+						tmp[2 + 2 * n] = (uint8_t)s[n];
+						tmp[3 + 2 * n] = 0;
+					}
+					tmp[0] = (uint8_t)(2 + 2 * n); tmp[1] = 3;
+					d = tmp; dl = 2 + 2 * n;
+				}
+				break;
+			}
+			if (d == NULL) {
+				return -1;
+			}
+			break;
+		case 5:                 /* SET_ADDRESS: the MAC applies it after the status stage */
+			wp210_ud.addr = (uint8_t)(val & 0x7f);
+			UMR(U_DEVICE_CONF) = (UMR(U_DEVICE_CONF) & ~(0x7fu << 24)) | ((uint32_t)wp210_ud.addr << 24);
+			return 0;
+		case 9:                 /* SET_CONFIGURATION */
+			if (val > 1) {
+				return -1;
+			}
+			wp210_ud.config = (uint8_t)val;
+			wp210_ud.alt = 0;
+			if (val == 1) {
+				wp210_ud_config_eps();
+			}
+			return 0;
+		case 8:                 /* GET_CONFIGURATION */
+			tmp[0] = wp210_ud.config; d = tmp; dl = 1;
+			break;
+		case 0:                 /* GET_STATUS */
+			tmp[0] = (type & 0x1f) == 0 ? 1 : 0; tmp[1] = 0; d = tmp; dl = 2;
+			break;
+		case 1: case 3:         /* CLEAR/SET_FEATURE */
+			return 0;
+		case 11:                /* SET_INTERFACE */
+			if (idx == 1 && val <= 1) {
+				wp210_ud.alt = (uint8_t)val;
+				wp210_ud.notify = val == 1 ? 1 : 0;
+				return 0;
+			}
+			return idx == 0 && val == 0 ? 0 : -1;
+		case 10:                /* GET_INTERFACE */
+			tmp[0] = idx == 1 ? wp210_ud.alt : 0; d = tmp; dl = 1;
+			break;
+		default:
+			return -1;
+		}
+	} else if ((type & 0x60) == 0x20) {
+		switch (req) {
+		case 0x80: d = wp210_ud_ntb; dl = sizeof(wp210_ud_ntb); break;     /* GET_NTB_PARAMETERS */
+		case 0x83: tmp[0] = 0; tmp[1] = 0; d = tmp; dl = 2; break;         /* GET_NTB_FORMAT: 16-bit */
+		case 0x85:                                                          /* GET_NTB_INPUT_SIZE */
+			tmp[0] = 0; tmp[1] = 0x40; tmp[2] = 0; tmp[3] = 0; d = tmp; dl = 4;
+			break;
+		case 0x87: tmp[0] = 0xea; tmp[1] = 0x05; d = tmp; dl = 2; break;   /* GET_MAX_DATAGRAM_SIZE */
+		case 0x84: case 0x88: case 0x43: case 0x40: case 0x41: case 0x42:  /* SET_NTB_FORMAT etc. */
+			return wlen ? 2 : 0;
+		case 0x86:                                                          /* SET_NTB_INPUT_SIZE */
+			return wlen ? 2 : 0;
+		default:
+			return -1;
+		}
+	} else {
+		return -1;
+	}
+	if (dl > wlen) {
+		dl = wlen;
+	}
+	memcpy(wp210_ud.buf, d, dl);
+	wp210_ud.len = dl;
+	wp210_ud.off = 0;
+	wp210_ud.zlp = dl < wlen && dl % 64 == 0;
+	return 1;
+}
+
+static void
+wp210_ud_ep0(void)
+{
+	uint32_t isr = UMR(U_EPISR) & 0x00010001u;
+	UMR(U_EPISR) = isr;
+	if (isr == 0) {
+		return;                 /* like mtu3_ep0_isr: act only on EP0ISR / SETUPENDISR */
+	}
+	if (isr & (1u << 16)) {
+		wp210_ud.state = 0;     /* SETUPEND: abort, take the new SETUP */
+	}
+	uint32_t csr = UMR(U_EP0CSR);
+	if (csr & EP0_SENTSTALL) {
+		UMR(U_EP0CSR) = ((csr & EP0_W1C) & ~EP0_SENDSTALL) | EP0_SENTSTALL;
+		wp210_ud.state = 0;
+		csr = UMR(U_EP0CSR);
+	}
+	switch (wp210_ud.state) {
+	case 1:
+		if (!(csr & EP0_FIFOFULL)) {
+			wp210_ud_tx();
+		}
+		break;
+	case 2:
+		if (csr & EP0_RXPKTRDY) {
+			uint8_t tmp[64];
+			unsigned cnt = UMR(U_RXCOUNT0) & 0xffff;
+			if (cnt > 64) {
+				cnt = 64;
+			}
+			wp210_ud_fifo_read(tmp, cnt);
+			wp210_ud.rxlen += cnt;
+			uint32_t w = (csr & EP0_W1C) | EP0_RXPKTRDY;
+			if (cnt < 64 || wp210_ud.rxlen >= wp210_ud.len) {
+				w |= EP0_DATAEND;
+				wp210_ud.state = 0;
+			}
+			UMR(U_EP0CSR) = w;
+		}
+		break;
+	case 3:
+		UMR(U_EP0CSR) = (csr & EP0_W1C) | EP0_DATAEND;
+		wp210_ud.state = 0;
+		break;
+	default:
+		if (csr & EP0_SETUPPKTRDY) {
+			uint8_t st[8];
+			unsigned cnt = UMR(U_RXCOUNT0) & 0xffff;
+			if (cnt != 8) {
+				printf("SWEET USB: wp210 SETUP length %u\n", cnt);
+				break;
+			}
+			wp210_ud_fifo_read(st, 8);
+			unsigned wlen = st[6] | (st[7] << 8);
+			int r = wp210_ud_request(st);
+			wp210_ud.setups++;
+			if (wp210_ud.logged++ < 160) {
+				printf("SWEET USB: wp210 SETUP %02x %02x %04x %04x %04x -> %s%s\n", st[0], st[1],
+				    st[2] | (st[3] << 8), st[4] | (st[5] << 8), wlen,
+				    r < 0 ? "STALL" : r == 1 ? "data IN " : r == 2 ? "data OUT" : "ok",
+				    r == 1 ? (wp210_ud.len == 0 ? "0" : "") : "");
+			}
+			csr = UMR(U_EP0CSR) & EP0_W1C;
+			if (r < 0) {
+				UMR(U_EP0CSR) = csr | EP0_SENDSTALL | (wlen ? 0 : EP0_SETUPPKTRDY);
+				wp210_ud.state = 0;
+			} else if (wlen == 0) {
+				UMR(U_EP0CSR) = csr | EP0_SETUPPKTRDY | EP0_DATAEND;
+				wp210_ud.state = 0;
+			} else if (st[0] & 0x80) {
+				UMR(U_EP0CSR) = csr | EP0_SETUPPKTRDY | EP0_DPHTX;
+				wp210_ud.state = 1;
+				if (r != 1) {
+					wp210_ud.len = wp210_ud.off = 0;
+					wp210_ud.zlp = 0;
+				}
+				wp210_ud_tx();
+			} else {
+				UMR(U_EP0CSR) = (csr | EP0_SETUPPKTRDY) & ~EP0_DPHTX;
+				wp210_ud.state = 2;
+				wp210_ud.len = wlen;
+				wp210_ud.rxlen = 0;
+			}
+		}
+		break;
+	}
+}
