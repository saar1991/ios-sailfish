+/*
+ * 0258: extension tokens. With ENOENT here tccd could not issue the
+ * kTCCServicePhotos extension, answered assetsd "Failed to issue Sandbox
+ * Extension" (auth_error_code 6), and assetsd aborted: "assetsd requires
+ * TCCPhotosService access" (log 522c92d3). Nothing is enforced, so a token
+ * only has to look like one and consume has to hand back a handle.
+ *
+ * libsystem_sandbox 20H392 __sandbox_extension_issue (disassembled): op 5,
+ * arg -> {char *class; u64 type (0 file, 1 mach, 3 generic); char *data;
+ * u64 flags; char *out (malloc 0x800); i64 pid; u64 pidversion}; on 0 the
+ * caller returns out as the token. sandbox_extension_consume: op 6, arg ->
+ * {char *token; u64 strlen + 1; i64 *handle}; returns *handle.
+ */
+static int
+sweet_sandbox_extension_issue(struct proc *p, user_addr_t arg)
+{
+	uint64_t a[7];
+	char cls[96];
+	size_t n;
+	int err;
+	static unsigned logged;
+
+	if (copyin(arg, a, sizeof(a)) != 0 || a[4] == 0) {
+		return EINVAL;
+	}
+	char *data = kalloc_data(MAXPATHLEN + 0x800, Z_WAITOK | Z_ZERO);
+	if (data == NULL) {
+		return ENOMEM;
+	}
+	char *tok = data + MAXPATHLEN;
+	cls[0] = 0;
+	if ((a[0] != 0 && copyinstr((user_addr_t)a[0], cls, sizeof(cls), &n) != 0) ||
+	    (a[2] != 0 && copyinstr((user_addr_t)a[2], data, MAXPATHLEN, &n) != 0)) {
+		kfree_data(data, MAXPATHLEN + 0x800);
+		return EINVAL;
+	}
+	/* Sandbox.kext's layout: hmac;flags;type;storage;length-of-class;class;...;length;data */
+	int len = snprintf(tok, 0x800, "%040x;%02x;%08x;%08x;%08x;%016llx;%s;%02x;%08x;%016llx;%s",
+	    0, (unsigned)(a[3] & 0xff), (unsigned)a[1], 0, 0, (unsigned long long)strlen(cls), cls, 1,
+	    0, (unsigned long long)strlen(data), data);
+	if (len < 0 || len >= 0x800) {
+		kfree_data(data, MAXPATHLEN + 0x800);
+		return ENAMETOOLONG;
+	}
+	if (logged++ < 40) {
+		char name[32];
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("SWEET Sandbox: %s issues %s extension type %llu for %s\n", name, cls,
+		    (unsigned long long)a[1], data[0] ? data : "-");
+	}
+	err = copyout(tok, (user_addr_t)a[4], (size_t)len + 1);
+	kfree_data(data, MAXPATHLEN + 0x800);
+	return err;
+}
