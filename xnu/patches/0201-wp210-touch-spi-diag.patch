+/*
+ * Round 3 diagnostics. The controller transfer of round 2 returned at once
+ * with all-zero data. Two independent checks:
+ *  - controller: register read-back, whether it ever reported busy, and an
+ *    internal loopback transfer (CMD bit 18) that needs no pins at all;
+ *  - bit-banged SPI on the same four pads as plain GPIOs (no controller, no
+ *    clock): MISO is GPIO 109 (the one input pad); clock, MOSI and chip
+ *    select are tried in all six orders over GPIO 110..112.
+ */
+static void
+wp210_bb_xfer(uint32_t cs, uint32_t clk, uint32_t mosi, const uint8_t *tx, uint8_t *rx, uint32_t len)
+{
+	wp210_gpio_out(cs, 0);
+	delay(20);
+	for (uint32_t i = 0; i < len; ++i) {
+		uint8_t in = 0;
+		for (int bit = 7; bit >= 0; --bit) {
+			wp210_gpio_out(mosi, (tx[i] >> bit) & 1u);
+			delay(2);
+			wp210_gpio_out(clk, 1);
+			in = (uint8_t)((in << 1) | (uint8_t)wp210_pin(109));
+			delay(2);
+			wp210_gpio_out(clk, 0);
+		}
+		rx[i] = in;
+	}
+	delay(20);
+	wp210_gpio_out(cs, 1);
+}
+
+static void
+wp210_tp_diag(void)
+{
+	static const uint8_t perm[6][3] = {      /* cs, clk, mosi */
+		{110, 111, 112}, {110, 112, 111}, {111, 110, 112},
+		{111, 112, 110}, {112, 110, 111}, {112, 111, 110},
+	};
+	uint8_t tx[32], rx[32];
+
+	/* Controller: loopback. */
+	for (uint32_t i = 0; i < 8; ++i) {
+		tx[i] = (uint8_t)(0xa1u + 0x11u * i);
+	}
+	memset(rx, 0, sizeof(rx));
+	wp210_spi_cmd_extra = 1u << 18;
+	bool ok = wp210_spi_xfer(tx, rx, 8);
+	wp210_spi_cmd_extra = 0;
+	printf("WP210 TP: ctl regs cfg0=%08x cfg1=%08x cmd=%08x cfg2=%08x st1=%08x\n",
+	    keys_rd(wp210_spi, 0x00), keys_rd(wp210_spi, 0x04), keys_rd(wp210_spi, 0x18),
+	    keys_rd(wp210_spi, 0x28), keys_rd(wp210_spi, 0x20));
+	printf("WP210 TP: ctl loopback ok=%d busy-seen=%d polls=%u\n", ok, wp210_spi_busy_seen, wp210_spi_polls);
+	wp210_tp_hex("ctl loopback rx", 0, rx, 8);
+
+	/* Bit-bang on the pads as GPIOs. */
+	memset(tx, 0xff, sizeof(tx));
+	tx[0] = 0xf1;
+	tx[1] = 0x00;
+	tx[2] = 0x01;
+	tx[3] = 0x00;
+	tx[4] = 0x14;
+	wp210_gpio_mode(109, 0);
+	wp210_gpio_field(0x10u * (109u / 32u), 109u % 32u, 1u, 0u);
+	for (uint32_t p = 110; p <= 112; ++p) {
+		wp210_gpio_mode(p, 0);
+	}
+	for (int k = 0; k < 6; ++k) {
+		/* idle: all three high-impedance-safe levels: cs high, others low */
+		wp210_gpio_out(perm[k][0], 1);
+		wp210_gpio_out(perm[k][1], 0);
+		wp210_gpio_out(perm[k][2], 0);
+		delay(200);
+		memset(rx, 0, sizeof(rx));
+		wp210_bb_xfer(perm[k][0], perm[k][1], perm[k][2], tx, rx, 31);
+		printf("WP210 TP: bitbang cs=%u clk=%u mosi=%u\n", perm[k][0], perm[k][1], perm[k][2]);
+		wp210_tp_hex("bitbang rx", 0, rx, 16);
+		wp210_tp_hex("bitbang rx", 16, rx + 16, 15);
+	}
+	for (uint32_t p = 109; p <= 112; ++p) {
+		wp210_gpio_field(0x10u * (p / 32u), p % 32u, 1u, 0u);
+		wp210_gpio_mode(p, 1);
+	}
+}
