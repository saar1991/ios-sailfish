+/* Latency probe (boot-arg wp210lat, default on): timestamps in microseconds
+ * so the log shows where the time goes between the driver and iOS. */
+static int wp210_lat_on = 1;
+static uint64_t
+wp210_lat_us(void)
+{
+	uint32_t s = 0, us = 0;
+	absolutetime_to_microtime(mach_absolute_time(), &s, &us);
+	return (uint64_t)s * 1000000u + us;
+}
