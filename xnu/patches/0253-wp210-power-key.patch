+/*
+ * 0253: the real power key, from the MT6363 PMIC (SPMI slave 4), read through the
+ * PMIF software channel 2 like Android's spmi-mtk-pmif (0252 proved it: identity
+ * 0x09/0x08 = 0x63/0x40, TOPSTATUS 0x1e idles at 0x1e and bit 1 drops to 0 while
+ * the power key is down). Device tree mt6363-keys: power (KEY_POWER) and "home"
+ * (keycode 115, volume up), both in TOPSTATUS. Read only.
+ * wp210keymap=1 (default): power key = Power, red side key = Home, volume down =
+ * volume down; every other TOPSTATUS change is logged (to find volume up).
+ * wp210keymap=0: the old layout (volume down = Home, red side key = Power, no PMIC).
+ */
+#define WP210_PMIF_PA 0x1c804000u
+static vm_offset_t wp210_pmif;
+static int wp210_keymap = 1;
+static int
+wp210_pmic_rd(uint32_t sid, uint32_t addr, uint32_t *val)
+{
+	volatile uint32_t *r = (volatile uint32_t *)wp210_pmif;
+	int i, ret = 0;
+	lck_mtx_lock(&sweet_pmic_lock);
+	for (i = 0; i < 1000 && ((r[0x8a8 / 4] >> 1) & 7) != 0; i++) {
+		delay(10);
+	}
+	if (i == 1000) {
+		ret = -1;
+		goto out;
+	}
+	r[0x880 / 4] = (3u << 30) | (sid << 24) | (addr & 0xffffu);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (i = 0; i < 1000 && ((r[0x8a8 / 4] >> 1) & 7) != 6; i++) {
+		delay(10);
+	}
+	if (i == 1000) {
+		ret = -2;
+		goto out;
+	}
+	*val = r[0x894 / 4] & 0xffu;
+	r[0x8a4 / 4] = 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+out:
+	lck_mtx_unlock(&sweet_pmic_lock);
+	return ret;
+}
+
 static void
 wp210_keys_thread(void *arg, wait_result_t result)
 {
 	static const uint32_t pin[2] = {WP210_GPIO_HOME, WP210_GPIO_SIDE};
-	static const int code[2] = {KEY_HOME, KEY_POWER};
