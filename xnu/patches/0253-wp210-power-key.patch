 	(void)arg;
 	(void)result;
+	if (wp210_keymap) {
+		code[0] = 2;            /* volume down */
+		code[1] = KEY_HOME;     /* red side key */
+		if (wp210_pmif != 0 && wp210_pmic_rd(4, 0x1e, &top) == 0) {
+			pmic_ok = 1;
+			printf("SWEET KEYS: wp210 PMIC TOPSTATUS %#x: power key on the MT6363\n", top);
+		} else {
+			printf("SWEET KEYS: wp210 PMIC read failed: no power key\n");
+		}
+	}
 	for (;;) {
 		for (int k = 0; k < 2; ++k) {
 			int now = !wp210_pin(pin[k]);
@@ -315,6 +370,23 @@ wp210_keys_thread(void *arg, wait_result_t result)
 				}
 			}
 		}
+		if (pmic_ok) {
+			if (wp210_pmic_rd(4, 0x1e, &v) != 0) {
+				if (++pmic_fail == 10) {
+					printf("SWEET KEYS: wp210 PMIC reads failing, power key stopped\n");
+					pmic_ok = 0;
+				}
+			} else if (v != top) {
+				int now = !(v & 0x2);
+				printf("SWEET KEYS: wp210 PMIC TOPSTATUS %#x -> %#x (changed bits %#x)\n", top, v, top ^ v);
+				top = v;
+				if (now != pwr) {
+					pwr = now;
+					printf("SWEET KEYS: wp210 key=%d down=%d (power key)\n", KEY_POWER, now);
+					sweet_hid_key(KEY_POWER, now);
+				}
+			}
+		}
 		keys_wait();
 	}
 }
