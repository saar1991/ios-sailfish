+/*
+ * wp210: the panel may scan any of LK's boot buffers. SweetFramebuffer
+ * (AppleCLCD) composes into buffer 0 (the boot_args video base) and copies
+ * each row into the other buffers through this.
+ */
+void sweet_fbcon_mirror_row(uint32_t x, uint32_t y, const void *src, size_t len);
+void
+sweet_fbcon_mirror_row(uint32_t x, uint32_t y, const void *src, size_t len)
+{
+	if (fbcon_nbuf <= 1 || fbcon_base == NULL) {
+		return;
+	}
+	for (uint32_t b = 1; b < fbcon_nbuf; b++) {
+		memcpy((void *)(fbcon_base + b * fbcon_buf_stride + (uint64_t)y * fbcon_stride + (uint64_t)x * 4), src, len);
+	}
+}
