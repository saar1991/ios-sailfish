+/*
+ * wp210: NT37705 command-mode panel behind MT6895's dual display pipe. The
+ * shim found that a frame goes out after pulsing both pipes' mutex EN 0 -> 1
+ * and then DSI_START 0 -> 1 (the MMSYS clocks are ungated once in fbcon_probe).
+ * Frames are spaced >= 1/60 s; a non-forced kick inside that window is dropped.
+ */
+static volatile uint32_t *fbcon_mtk_mutex[2];
+static volatile uint32_t *fbcon_mtk_dsi;
+static uint64_t fbcon_mtk_last;
+
+static void
+fbcon_mtk_kick(bool force)
+{
+	uint64_t gap = gPEClockFrequencyInfo.timebase_frequency_hz / 60;
+	for (;;) {
+		if (os_atomic_cmpxchg(&fbcon_kick_lock, 0u, 1u, acquire)) {
+			uint64_t now = mach_absolute_time();
+			if (now - fbcon_mtk_last >= gap) {
+				__builtin_arm_dsb(DSB_SY);      /* console pixels out of the WC buffer */
+				for (int i = 0; i < 2; i++) {
+					if (fbcon_mtk_mutex[i] != NULL) {
+						*fbcon_mtk_mutex[i] = 0;
+						*fbcon_mtk_mutex[i] = 1;
+					}
+				}
+				*fbcon_mtk_dsi = 0;
+				*fbcon_mtk_dsi = 1;
+				fbcon_mtk_last = now;
+				sweet_fbcon_stat_kicks++;
+				os_atomic_store(&fbcon_kick_lock, 0u, release);
+				return;
+			}
+			os_atomic_store(&fbcon_kick_lock, 0u, release);
+		}
+		if (!force) {
+			return;
+		}
+		delay(1000);
+	}
+}
