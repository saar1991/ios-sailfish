@@ -360,6 +360,17 @@ _kernelrpc_mach_port_construct_trap(struct _kernelrpc_mach_port_construct_args *
 	if (rv == KERN_SUCCESS) {
 		rv = mach_copyout(&name, args->name, sizeof(name));
 	}
