+	{
+		/* 0219: the flags of the ports the processes named in sweetsys construct (bsd/dev/sweet_perf.c) */
+		extern void *sweet_sys_task[2];
+		extern void sweet_sys_construct(int which, uint32_t flags, int rv);
+		void *t = (void *)current_task();
+		if (__improbable(t == sweet_sys_task[0] || t == sweet_sys_task[1])) {
+			sweet_sys_construct(t == sweet_sys_task[0] ? 0 : 1, options.flags, rv);
+		}
+	}
