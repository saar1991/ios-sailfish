     sweet_fb_stat_stage_cpu[8], sweet_fb_stat_stage_cpu_abs[8];
 extern int sweet_fb_own_cached;
 extern bool sweet_fbcon_te_probe(uint32_t out[11]);
+extern bool sweet_fbcon_mtk_dsi_regs(uint32_t out[192]);
