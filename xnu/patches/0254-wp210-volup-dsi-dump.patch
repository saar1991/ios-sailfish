@@ -2291,6 +2292,19 @@ wp210_mhz_fast(void *arg, wait_result_t result)
 				    te[10] == 0 ? "no TE" : te[10] == (1u << 4) ? "EXT_TE_RDY" : "TE_RDY");
 			}
 		}
+		/* 0254: the DSI's registers once, at 30 s (for panel brightness) */
+		static int dsi_dumped;
+		if (up >= 30 && !dsi_dumped) {
+			static uint32_t r[192];
+			dsi_dumped = 1;
+			if (sweet_fbcon_mtk_dsi_regs(r)) {
+				for (int o = 0; o < 192; o += 16) {
+					printf("SWEET DSI: %03x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x %x\n", o * 4,
+					    r[o], r[o + 1], r[o + 2], r[o + 3], r[o + 4], r[o + 5], r[o + 6], r[o + 7],
+					    r[o + 8], r[o + 9], r[o + 10], r[o + 11], r[o + 12], r[o + 13], r[o + 14], r[o + 15]);
+				}
+			}
+		}
 		perf_wait(up < 150 ? 1 : 5);
 	}
 }
diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index bce4ebe..0ba7755 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -1057,6 +1057,26 @@ fbcon_mtk_te_count(uint32_t flag, uint32_t ms, uint32_t *period_us)
  * count, period, the same with EXT_TE_EN, period, the flag frames start on.
  * Returns false without a MediaTek DSI.
  */
+/*
+ * 0254: the MediaTek DSI's registers, read only, for panel brightness: the NT37705
+ * takes DCS 0x51, sent from the DSI command queue (Linux mtk_dsi.c: CMDQ_SIZE
+ * +0x60, CMDQ +0x200, START +0x00, INTSTA +0x0c bit 1 CMD_DONE). The queue may
+ * hold LK's frame-transfer command, which a brightness command would have to
+ * share: see what is there. Copies words +0x000..+0x2fc into out[192].
+ */
+bool sweet_fbcon_mtk_dsi_regs(uint32_t out[192]);
+bool
+sweet_fbcon_mtk_dsi_regs(uint32_t out[192])
+{
+	if (fbcon_mtk_dsi == NULL) {
+		return false;
+	}
+	for (int i = 0; i < 192; i++) {
+		out[i] = fbcon_mtk_dsi[i];
+	}
+	return true;
+}
+
 bool sweet_fbcon_te_probe(uint32_t out[11]);
 bool
 sweet_fbcon_te_probe(uint32_t out[11])
