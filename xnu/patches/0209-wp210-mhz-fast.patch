--- a/bsd/dev/sweet_perf.c
+++ b/bsd/dev/sweet_perf.c
@@ -677,6 +677,103 @@
 }
 
 #define PERF_SAFE_CPUS 8
+
+/*
+ * sweetperf=2: every CPU's clock once a second for the first 150 s after
+ * boot, with the cpufreq state of each domain. The CPUs XNU numbers 0-3
+ * drop to half their clock at some point while the system starts (8 cores:
+ * the A55s, 2000 -> 999 MHz; cpus=5 big-first: the boot A55 and the three
+ * domain-1 A78s, 2350 -> 1174), the cpufreq state unchanged. These lines
+ * sit among the boot log's, to show what the drop coincides with.
+ */
+static void
+wp210_mhz_fast(void *arg, wait_result_t result)
+{
+	int ncpu = (int)ml_get_cpu_count(), tries[3] = {0, 0, 0};
+	uint64_t last[3] = {0, 0, 0};
+	(void)arg;
+	(void)result;
+	if (ncpu > PERF_SAFE_CPUS) {
+		ncpu = PERF_SAFE_CPUS;
+	}
+	for (;;) {
+		uint64_t up = perf_ns(mach_absolute_time()) / NSEC_PER_SEC;
+		uint64_t mhz[PERF_SAFE_CPUS] = {0};
+		int dom[PERF_SAFE_CPUS];
+		for (int c = 0; c < ncpu; c++) {
+			uint64_t mpidr;
+			thread_bind(cpu_to_processor(c));
+			thread_block(THREAD_CONTINUE_NULL);	/* migrate */
+			__asm__ volatile ("mrs %0, mpidr_el1" : "=r"(mpidr));
+			mhz[c] = perf_mhz();
+			/* physical core (Aff1): 0-3 A55 domain 0, 4-6 A78 domain 1, 7 domain 2 */
+			unsigned core = (unsigned)((mpidr >> 8) & 0xff);
+			dom[c] = core < 4 ? 0 : core < 7 ? 1 : 2;
+		}
+		thread_bind(NULL);
+		uint32_t st[3] = {0, 0, 0};
+		for (int d = 0; d < 3 && wp210_csram != 0; d++) {
+			st[d] = ((volatile uint32_t *)(wp210_csram + wp210_cpufreq_dom[d]))[0x88 / 4];
+		}
+		if (up <= 150) {
+			printf("SWEET MHZ: %llu s %llu/%llu/%llu/%llu/%llu/%llu/%llu/%llu state %u/%u/%u\n",
+			    (unsigned long long)up, (unsigned long long)mhz[0], (unsigned long long)mhz[1],
+			    (unsigned long long)mhz[2], (unsigned long long)mhz[3], (unsigned long long)mhz[4],
+			    (unsigned long long)mhz[5], (unsigned long long)mhz[6], (unsigned long long)mhz[7],
+			    st[0], st[1], st[2]);
+		}
+		/*
+		 * A domain under 60% of its table clock (the halving at about 40 s
+		 * after boot) while its state holds the wanted index: request the
+		 * index again, at most once in 5 s per domain, for as long as the
+		 * system runs. The neighbouring index then the wanted one brought
+		 * domain 1 back (log 47c1078b) but not domain 0, so domain 0's
+		 * tries also go through a far index (1000 MHz), the enable value
+		 * LK left (0x301), and enable off and on, in turn.
+		 */
+		for (int d = 0; d < 3 && wp210_csram != 0; d++) {
+			volatile uint32_t *r = (volatile uint32_t *)(wp210_csram + wp210_cpufreq_dom[d]);
+			if (wp210_want[d] < 0 || up < last[d] + 5) {
+				continue;
+			}
+			uint64_t want = r[wp210_want[d]] & 0xfffu, low = 0;
+			for (int c = 0; c < ncpu; c++) {
+				if (dom[c] == d && mhz[c] != 0 && mhz[c] * 10 < want * 6) {
+					low = mhz[c];
+				}
+			}
+			if (low == 0) {
+				continue;
+			}
+			int how = d == 0 ? tries[d] % 4 : 0, far = 13;
+			static const char *const hows[4] = {"next index", "far index", "enable 0x301", "enable off/on"};
+			tries[d]++;
+			last[d] = up;
+			if (how == 2) {
+				r[0x84 / 4] = 0x301;
+			} else if (how == 3) {
+				r[0x84 / 4] = 0;
+				__asm__ volatile ("dsb sy" ::: "memory");
+				delay(2000);
+				r[0x84 / 4] = 1;
+			}
+			__asm__ volatile ("dsb sy" ::: "memory");
+			delay(2000);
+			r[0x88 / 4] = (uint32_t)(how == 1 ? far : wp210_want[d] > 0 ? wp210_want[d] - 1 : wp210_want[d] + 1);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			delay(how == 1 ? 5000 : 2000);
+			r[0x88 / 4] = (uint32_t)wp210_want[d];
+			__asm__ volatile ("dsb sy" ::: "memory");
+			delay(2000);
+			if (tries[d] <= 40) {
+				printf("SWEET MHZ: %llu s domain %d read %llu MHz of %llu: index requested again by %s (try %d), "
+				    "state %u hw %#x enable %#x\n", (unsigned long long)up, d, (unsigned long long)low,
+				    (unsigned long long)want, hows[how], tries[d], r[0x88 / 4], r[0x8c / 4], r[0x84 / 4]);
+			}
+		}
+		perf_wait(up < 150 ? 1 : 5);
+	}
+}
 
 static void
 perf_thread_safe(void *arg, wait_result_t result)
@@ -833,6 +930,10 @@
 	if (!enabled) {
 		return;
 	}
+	/* sweetperf=2: also the once-a-second clocks of the first 150 s */
+	if (enabled == 2 && kernel_thread_start(wp210_mhz_fast, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 	if (kernel_thread_start(enabled == 2 ? perf_thread_safe : perf_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
