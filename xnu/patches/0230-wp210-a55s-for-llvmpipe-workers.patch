diff --git a/bsd/dev/sweet_perf.c b/bsd/dev/sweet_perf.c
index 7e832cd..9de0f2d 100644
--- a/bsd/dev/sweet_perf.c
+++ b/bsd/dev/sweet_perf.c
@@ -44,6 +44,8 @@
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
+#include <machine/atomic.h>
+#include <kern/cpu_number.h>
 
 extern struct processor *cpu_to_processor(int cpu);
 extern struct processor *thread_bind(struct processor *processor);
@@ -1035,6 +1037,80 @@ wp210_clktree(uint64_t up)
 	}
 }
 
+/*
+ * 0230: wp210slow=N. With 8 cores CA's render thread ran on the A55s 35%
+ * of the time (log 03157eac), and the frames fell 790 -> 685, though the
+ * rasterizer gained from them. The A55s (physical cores 0-3, found from
+ * MPIDR below) are taken out of the recommended set: the scheduler then
+ * runs only threads bound to them there (the performance controller's
+ * mechanism). llvmpipe's workers llvmpipe-N.. bind themselves to them, one
+ * each, when they name themselves (proc_info PROC_SELFSET_THREADNAME).
+ * llvmpipe hands out bins as threads ask, so slower workers just take fewer.
+ */
+extern bool perfcontrol_failsafe_active;
+extern uint64_t perfcontrol_requested_recommended_cores;
+static int sweet_slow_first;		/* wp210slow, 0 = off */
+static int sweet_slow_cpu[PERF_SAFE_CPUS];
+static int sweet_slow_count;		/* set once the A55s are out of the recommended set */
+static uint32_t sweet_slow_bound, sweet_slow_named;
+void sweet_thread_named(const char *name);
+
+void
+sweet_thread_named(const char *name)
+{
+	if (strncmp(name, "llvmpipe-", 9) != 0) {
+		return;
+	}
+	const char *p = name + 9;
+	int n = 0;
+	if (*p < '0' || *p > '9') {
+		return;
+	}
+	while (*p >= '0' && *p <= '9' && n < 1000) {
+		n = n * 10 + (*p++ - '0');
+	}
+	sweet_slow_named++;
+	int count = os_atomic_load(&sweet_slow_count, acquire);
+	int k = n - sweet_slow_first;
+	if (sweet_slow_first == 0 || k < 0 || k >= count) {
+		printf("SWEET SLOW: %s (thread %llu) not bound (first %d, %d slow cpus)\n", name,
+		    (unsigned long long)thread_tid(current_thread()), sweet_slow_first, count);
+		return;
+	}
+	int cpu = sweet_slow_cpu[k];
+	thread_bind(cpu_to_processor(cpu));
+	thread_block(THREAD_CONTINUE_NULL);	/* migrate */
+	sweet_slow_bound++;
+	printf("SWEET SLOW: %s (thread %llu) bound to cpu %d, now on cpu %d\n", name,
+	    (unsigned long long)thread_tid(current_thread()), cpu, cpu_number());
+}
+
+static void
+sweet_slow_apply(int ncpu, const int *dom)
+{
+	static bool done;
+	if (done || sweet_slow_first == 0) {
+		return;
+	}
+	done = true;
+	uint32_t all = (uint32_t)((1u << ncpu) - 1), slow = 0;
+	int count = 0;
+	for (int c = 0; c < ncpu; c++) {
+		if (dom[c] == 0) {
+			slow |= 1u << c;
+			sweet_slow_cpu[count++] = c;
+		}
+	}
+	if (count == 0 || (all & ~slow) == 0) {
+		printf("SWEET SLOW: not applied: cpus %#x, A55s %#x\n", all, slow);
+		return;
+	}
+	sched_perfcontrol_update_recommended_cores(all & ~slow);
+	os_atomic_store(&sweet_slow_count, count, release);
+	printf("SWEET SLOW: A55 cpus %#x out of the recommended set (now %#llx), llvmpipe-%d.. bind to them\n",
+	    slow, (unsigned long long)perfcontrol_requested_recommended_cores, sweet_slow_first);
+}
+
 /*
  * sweetperf=2: every CPU's clock once a second for the first 150 s after
  * boot, with the cpufreq state of each domain. The CPUs XNU numbers 0-3
@@ -1069,6 +1145,7 @@ wp210_mhz_fast(void *arg, wait_result_t result)
 			dom[c] = core < 4 ? 0 : core < 7 ? 1 : 2;
 		}
 		thread_bind(NULL);
+		sweet_slow_apply(ncpu, dom);
 		uint32_t st[3] = {0, 0, 0};
 		for (int d = 0; d < 3 && wp210_csram != 0; d++) {
 			st[d] = ((volatile uint32_t *)(wp210_csram + wp210_cpufreq_dom[d]))[0x88 / 4];
@@ -1167,6 +1244,12 @@ wp210_mhz_fast(void *arg, wait_result_t result)
 				}
 			}
 			printf("\n");
+			/* 0230 */
+			if (sweet_slow_first != 0) {
+				printf("SWEET SLOW: %llu s recommended %#llx, failsafe %d, llvmpipe threads named %u, bound %u\n",
+				    (unsigned long long)up, (unsigned long long)perfcontrol_requested_recommended_cores,
+				    perfcontrol_failsafe_active, sweet_slow_named, sweet_slow_bound);
+			}
 		}
 		/* system calls of launchd and mediaserverd, every 10 s (0218) */
 		if (up >= 20 && up <= 400 && up % 10 < (up < 150 ? 1u : 5u) && up / 10 != sys_last) {
@@ -1371,6 +1454,7 @@ sweet_perf_init(void)
 		return;
 	}
 	/* sweetperf=2: also the once-a-second clocks of the first 150 s */
+	PE_parse_boot_argn("wp210slow", &sweet_slow_first, sizeof(sweet_slow_first));
 	if (enabled == 2 && kernel_thread_start(wp210_mhz_fast, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
