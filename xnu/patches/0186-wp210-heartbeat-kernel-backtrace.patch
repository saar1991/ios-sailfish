diff --git a/osfmk/kern/bsd_kern.c b/osfmk/kern/bsd_kern.c
index ea61b4b..7e1681d 100644
--- a/osfmk/kern/bsd_kern.c
+++ b/osfmk/kern/bsd_kern.c
@@ -1516,6 +1516,9 @@ bsd_to_mach_failure(int bsd_err)
 }
 
 #if defined(__arm64__)
+#if __has_feature(ptrauth_calls)
+#include <ptrauth.h>
+#endif
 /* wp210 bring-up: called from the bsd_init heartbeat (wp210hb=1). */
 void wp210_dump_task(task_t task);
 void
@@ -1539,6 +1542,26 @@ wp210_dump_task(task_t task)
 		} else {
 			printf("  thr %llu state 0x%x (no user state)\n", thread->thread_id, thread->state);
 		}
+		/*
+		 * Kernel side: the context saved at the last switch-out, then the
+		 * frame-pointer chain. Unslid addresses: symbolicate with the kernel's nm.
+		 */
+		if (thread != current_thread() && thread->machine.kstackptr != 0) {
+			struct thread_kernel_state *ks = (struct thread_kernel_state *)thread->machine.kstackptr;
+			uint64_t lo = thread->machine.kstackptr - kernel_stack_size, hi = thread->machine.kstackptr;
+			uint64_t fp = ks->machine.ss.fp;
+			printf("  k lr 0x%llx bt", (unsigned long long)(ks->machine.ss.lr - vm_kernel_slide));
+			for (int i = 0; i < 10 && fp >= lo && fp + 16 <= hi && (fp & 7) == 0; i++) {
+				uint64_t *frame = (uint64_t *)fp;
+				uint64_t ret = frame[1];
+#if __has_feature(ptrauth_calls)
+				ret = (uint64_t)ptrauth_strip((void *)ret, ptrauth_key_return_address);
+#endif
+				printf(" %llx", (unsigned long long)(ret - vm_kernel_slide));
+				fp = frame[0];
+			}
+			printf("\n");
+		}
 	}
 }
 #endif
