+
+/*
+ * 0257 (wp210lat): touch-to-panel latency. SweetHID arms a probe at a touch
+ * going down and at the start of a finger's movement; the first frame
+ * backboardd swaps in after it and the first panel copy that includes it
+ * are timed from the touch:
+ *   WP210 LAT2 down|move at X,Y: frame +S ms, panel +P ms
+ * frame = backboardd submitted a frame (its reaction began), panel = the
+ * presenter finished copying it to the panel's buffer (it shows at the
+ * panel's next refresh, within 16.7 ms more).
+ */
+struct sweet_lat_probe {
+	volatile int armed;     /* 1 waiting for a swap, 2 for the present */
+	uint64_t t_ev, t_swap;
+	int x, y;
+	const char *what;
+};
+static struct sweet_lat_probe sweet_lat[2];
+extern "C" void sweet_lat_arm(int which, const char *what, int x, int y);
+extern "C" void
+sweet_lat_arm(int which, const char *what, int x, int y)
+{
+	if (which < 0 || which > 1) {
+		return;
+	}
+	struct sweet_lat_probe *p = &sweet_lat[which];
+	p->armed = 0;
+	__asm__ volatile ("dmb ish" ::: "memory");
+	p->t_ev = mach_absolute_time();
+	p->t_swap = 0;
+	p->x = x, p->y = y;
+	p->what = what;
+	__asm__ volatile ("dmb ish" ::: "memory");
+	p->armed = 1;
+}
+
+static void
+sweet_lat_swapped(uint64_t now)
+{
+	for (int i = 0; i < 2; i++) {
+		if (sweet_lat[i].armed == 1 && now >= sweet_lat[i].t_ev) {
+			sweet_lat[i].t_swap = now;
+			__asm__ volatile ("dmb ish" ::: "memory");
+			sweet_lat[i].armed = 2;
+		}
+	}
+}
+
+static void
+sweet_lat_presented(uint64_t started, uint64_t now)
+{
+	for (int i = 0; i < 2; i++) {
+		struct sweet_lat_probe *p = &sweet_lat[i];
+		if (p->armed == 2 && p->t_swap <= started) {
+			uint64_t s, q;
+			absolutetime_to_nanoseconds(p->t_swap - p->t_ev, &s);
+			absolutetime_to_nanoseconds(now - p->t_ev, &q);
+			IOLog("WP210 LAT2 %s at %d,%d: frame +%llu.%llu ms, panel +%llu.%llu ms\n", p->what, p->x, p->y,
+			    s / 1000000, (s / 100000) % 10, q / 1000000, (q / 100000) % 10);
+			p->armed = 0;
+		}
+	}
+}
