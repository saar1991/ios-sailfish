+/*
+ * 0257 (wp210lat, default on): per gesture (first finger down to last up)
+ * the latency probes of SweetFramebuffer (touch down, start of movement:
+ * 30 touch units from where it went down), and on release
+ *   WP210 GESTURE N ms, frames F (M during movement: R per s), moves K
+ */
+extern "C" void sweet_lat_arm(int which, const char *what, int x, int y);
+extern "C" uint64_t sweet_fb_stat_swaps;
+
+static void
+sweet_lat_touch(int finger, int down, int x, int y)
+{
+	static int on = -1;
+	static uint32_t fingers;
+	static int x0, y0, moved;
+	static uint64_t t_down, t_move, swaps_down, swaps_move, moves;
+	if (on < 0) {
+		on = 1;
+		(void)PE_parse_boot_argn("wp210lat", &on, sizeof(on));
+	}
+	if (!on || finger < 0 || finger > 31) {
+		return;
+	}
+	uint32_t was = fingers;
+	if (down) {
+		fingers |= 1u << finger;
+	} else {
+		fingers &= ~(1u << finger);
+	}
+	uint64_t now = mach_absolute_time(), swaps = *(volatile uint64_t *)&sweet_fb_stat_swaps;
+	if (was == 0 && fingers != 0) {
+		x0 = x, y0 = y, moved = 0, moves = 0;
+		t_down = now, swaps_down = swaps;
+		sweet_lat_arm(0, "down", x, y);
+		return;
+	}
+	if (fingers != 0 && down) {
+		moves++;
+		int d = (x > x0 ? x - x0 : x0 - x) + (y > y0 ? y - y0 : y0 - y);
+		if (!moved && d >= 30) {
+			moved = 1;
+			t_move = now, swaps_move = swaps;
+			sweet_lat_arm(1, "move", x, y);
+		}
+		return;
+	}
+	if (was != 0 && fingers == 0) {
+		uint64_t dur, mv = 0;
+		absolutetime_to_nanoseconds(now - t_down, &dur);
+		if (moved) {
+			absolutetime_to_nanoseconds(now - t_move, &mv);
+		}
+		uint64_t fm = moved ? swaps - swaps_move : 0;
+		IOLog("WP210 GESTURE %llu ms, frames %llu (%llu during movement: %llu per s), moves %llu\n",
+		    dur / 1000000, swaps - swaps_down, fm, mv ? fm * 1000000000ull / mv : 0, moves);
+	}
+}
+
 extern "C" void
 sweet_hid_touch(int finger, int down, int x, int y)
 {
+	sweet_lat_touch(finger, down, x, y);
 	if (gSweetTouch) {
 		gSweetTouch->touch(finger, down != 0, x, y);
 	}
