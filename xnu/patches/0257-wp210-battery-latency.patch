+static const uint16_t wp210_ocv_v[] = {
+	0xad96, 0xacec, 0xac83, 0xac02, 0xabb0, 0xab4c, 0xaadf, 0xaa73, 0xaa0a, 0xa983, 0xa925, 0xa89b,
+	0xa834, 0xa79d, 0xa72c, 0xa6b0, 0xa63c, 0xa5c3, 0xa529, 0xa4c4, 0xa442, 0xa3bd, 0xa33a, 0xa2b1,
+	0xa23c, 0xa1d8, 0xa15a, 0xa0e9, 0xa063, 0x9ffe, 0x9f8c, 0x9f1a, 0x9ea5, 0x9e3f, 0x9dcb, 0x9d77,
+	0x9d13, 0x9cac, 0x9c4a, 0x9bf2, 0x9b9a, 0x9b2e, 0x9ab7, 0x9a3a, 0x99bf, 0x991e, 0x9898, 0x9844,
+	0x97f6, 0x97aa, 0x976b, 0x972a, 0x9708, 0x96c5, 0x9691, 0x9657, 0x9615, 0x95ed, 0x95d3, 0x9599,
+	0x9567, 0x9530, 0x951b, 0x94fa, 0x94cd, 0x94b3, 0x948e, 0x9477, 0x943d, 0x943a, 0x9405, 0x93d6,
+	0x93a9, 0x937d, 0x933c, 0x9315, 0x92eb, 0x92bd, 0x92a1, 0x9271, 0x924e, 0x9223, 0x91e0, 0x919c,
+	0x9162, 0x911b, 0x90cd, 0x907c, 0x905c, 0x9051, 0x904d, 0x9036, 0x9027, 0x8ff6, 0x8f38, 0x8da0,
+	0x8b68, 0x8856, 0x83c1, 0x83ac,
