+/*
+ * 0257: battery on the WP210. USB power from the MT6363's TOPSTATUS bit 2
+ * (the keys thread reads it every 20 ms). Voltage and current from the
+ * MT6375 charger's ADC over I2C bus 5 (0x11280000, "mediatek,mt6983-i2c",
+ * register layout v2 of Linux i2c-mt65xx.c), where the MT6375 answers at
+ * six addresses: a register number 0xBBRR is register RR at the address of
+ * bank BB (Linux mfd/mt6375.c: 0x4e TCPC, 0x34 PMU, 0x1a BM, 0x4a HK1,
+ * 0x64 HK2, 0x3f TM). The I2C controller is used as LK left it (timing
+ * registers untouched): FIFO mode, polled, no interrupt. Its clock gate:
+ * imp_iic_wrap_c 0x11282000 + 0xe00 bit 0 (1 = gated; cleared via 0xe04).
+ * ADC (iio/adc/mt6375-adc.c): one-shot channel N by writing N << 4 to
+ * CFG3 0x1a6, ~4.4 ms, wait for CFG3[7:4] = 0, the result big-endian at
+ * 0x1aa + 2 (N - 1); VBAT N = 4 (1.25 mV a step), IBAT N = 6 (2.5 mA a
+ * step); ADCEN = CFG1 0x1a4 bit 7. Percent: the battery's 25 C OCV table
+ * from the device tree (mtk_gauge battery0_profile_t1: capacity used,
+ * OCV in 0.1 mV), voltage averaged over the last 4 samples.
+ * Boot-arg wp210battery=0: none of this (static 100%, external power).
+ */
+#define WP210_I2C5_PA   0x11280000u
+#define WP210_IMPC_PA   0x11282000u
+#define I2C_DATA_PORT   0x00
+#define I2C_INTR_MASK   0x08
+#define I2C_INTR_STAT   0x0c
+#define I2C_CONTROL     0x10
+#define I2C_TRANSFER_LEN 0x14
+#define I2C_TRANSAC_LEN 0x18
+#define I2C_TIMING      0x20
+#define I2C_START       0x24
+#define I2C_EXT_CONF    0x28
+#define I2C_LTIMING     0x2c
+#define I2C_HS          0x30
+#define I2C_IO_CONFIG   0x34
+#define I2C_FIFO_ADDR_CLR 0x38
+#define I2C_TRANSFER_LEN_AUX 0x44
+#define I2C_CLOCK_DIV   0x48
+#define I2C_SLAVE_ADDR1 0x94
+#define I2C_DEBUGSTAT   0xe4
+#define I2C_FIFO_STAT   0xf4
+#define I2C_ST_COMP     0x01
+#define I2C_ST_ACKERR   0x02
+#define I2C_ST_HSNACK   0x04
+#define I2C_ST_ARB      0x08
+#define I2C_ST_RS       0x10
+#define I2C_ST_CONFERR  0x200
+#define I2C_CTL_RS      0x02
+#define I2C_CTL_DMA     0x04
+#define I2C_CTL_CLKEXT  0x08
+#define I2C_CTL_DIRCHG  0x10
+#define I2C_CTL_ACKDET  0x20
+#define I2C_CTL_DMAACK  0x100
+#define I2C_CTL_ASYNC   0x200
+
+static vm_offset_t wp210_i2c, wp210_impc;
+static int wp210_i2c_state;     /* 0 not tried, 1 usable, -1 not */
+static LCK_MTX_DECLARE(wp210_i2c_lock, &sweet_pmic_grp);
+
+static inline uint16_t
+wp210_i2c_rd(uint32_t off)
+{
+	uint16_t v = *(volatile uint16_t *)(wp210_i2c + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wp210_i2c_wr(uint32_t off, uint16_t v)
+{
+	*(volatile uint16_t *)(wp210_i2c + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static int
+wp210_i2c_init(void)
+{
+	if (wp210_i2c_state != 0) {
+		return wp210_i2c_state;
+	}
+	wp210_i2c_state = -1;
+	wp210_impc = ml_io_map(WP210_IMPC_PA, 0x1000);
+	wp210_i2c = ml_io_map(WP210_I2C5_PA, 0x1000);
+	if (wp210_impc == 0 || wp210_i2c == 0) {
+		printf("SWEET BATTERY: wp210 I2C5 mapping failed\n");
+		return -1;
+	}
+	uint32_t cg = *(volatile uint32_t *)(wp210_impc + 0xe00);
+	if (cg & 1u) {
+		*(volatile uint32_t *)(wp210_impc + 0xe04) = 1u;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		delay(10);
+		printf("SWEET BATTERY: wp210 I2C5 clock was gated (%#x), ungated: %#x\n", cg,
+		    *(volatile uint32_t *)(wp210_impc + 0xe00));
+		if (*(volatile uint32_t *)(wp210_impc + 0xe00) & 1u) {
+			return -1;
+		}
+	}
+	uint16_t ctl = wp210_i2c_rd(I2C_CONTROL), tim = wp210_i2c_rd(I2C_TIMING);
+	printf("SWEET BATTERY: wp210 I2C5 cg %#x control %#x timing %#x ltiming %#x clkdiv %#x hs %#x io %#x ext %#x "
+	    "mask %#x stat %#x debug %#x fifo %#x\n", cg, ctl, tim, wp210_i2c_rd(I2C_LTIMING),
+	    wp210_i2c_rd(I2C_CLOCK_DIV), wp210_i2c_rd(I2C_HS), wp210_i2c_rd(I2C_IO_CONFIG),
+	    wp210_i2c_rd(I2C_EXT_CONF), wp210_i2c_rd(I2C_INTR_MASK), wp210_i2c_rd(I2C_INTR_STAT),
+	    wp210_i2c_rd(I2C_DEBUGSTAT), wp210_i2c_rd(I2C_FIFO_STAT));
+	if (tim == 0) {
+		printf("SWEET BATTERY: wp210 I2C5 timing not set up by LK: not used\n");
+		return -1;
+	}
+	wp210_i2c_state = 1;
+	return 1;
+}
+
+/* One transfer: write wn bytes, then (rn > 0) a repeated start and read rn bytes. FIFO: at most 16 each. */
+static int
+wp210_i2c_xfer(uint8_t addr7, const uint8_t *w, int wn, uint8_t *r, int rn)
+{
+	if (wn < 1 || wn > 16 || rn < 0 || rn > 16) {
+		return -1;
+	}
+	lck_mtx_lock(&wp210_i2c_lock);
+	uint16_t ctl = wp210_i2c_rd(I2C_CONTROL) &
+	    (uint16_t)~(I2C_CTL_DIRCHG | I2C_CTL_RS | I2C_CTL_DMA | I2C_CTL_DMAACK | I2C_CTL_ASYNC);
+	ctl |= I2C_CTL_CLKEXT | I2C_CTL_ACKDET;
+	if (rn > 0) {
+		ctl |= I2C_CTL_DIRCHG | I2C_CTL_RS;
+	}
+	const uint16_t all = I2C_ST_RS | I2C_ST_CONFERR | I2C_ST_HSNACK | I2C_ST_ACKERR | I2C_ST_ARB | I2C_ST_COMP;
+	wp210_i2c_wr(I2C_CONTROL, ctl);
+	wp210_i2c_wr(I2C_SLAVE_ADDR1, (uint16_t)(addr7 << 1));
+	wp210_i2c_wr(I2C_INTR_STAT, all);
+	wp210_i2c_wr(I2C_FIFO_ADDR_CLR, 1);
+	wp210_i2c_wr(I2C_INTR_MASK, 0);
+	wp210_i2c_wr(I2C_TRANSFER_LEN, (uint16_t)wn);
+	if (rn > 0) {
+		wp210_i2c_wr(I2C_TRANSFER_LEN_AUX, (uint16_t)rn);
+		wp210_i2c_wr(I2C_TRANSAC_LEN, 2);
+	} else {
+		wp210_i2c_wr(I2C_TRANSAC_LEN, 1);
+	}
+	for (int i = 0; i < wn; i++) {
+		*(volatile uint8_t *)(wp210_i2c + I2C_DATA_PORT) = w[i];
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wp210_i2c_wr(I2C_START, 0x0001 | 0x4000);       /* TRANSAC_START | RS_MUL_TRIG (auto restart) */
+	uint16_t st = 0;
+	int i;
+	for (i = 0; i < 2000; i++) {
+		st = wp210_i2c_rd(I2C_INTR_STAT);
+		if (st & (I2C_ST_COMP | I2C_ST_ACKERR | I2C_ST_HSNACK | I2C_ST_ARB)) {
+			break;
+		}
+		delay(5);
+	}
+	wp210_i2c_wr(I2C_INTR_STAT, all);
+	int ret = 0;
+	if (i == 2000) {
+		ret = -2;
+	} else if (st & (I2C_ST_ACKERR | I2C_ST_HSNACK | I2C_ST_ARB)) {
+		ret = -3;
+	} else {
+		for (int k = 0; k < rn; k++) {
+			r[k] = *(volatile uint8_t *)(wp210_i2c + I2C_DATA_PORT);
+		}
+	}
+	if (ret != 0) {
+		wp210_i2c_wr(I2C_FIFO_ADDR_CLR, 1);
+	}
+	lck_mtx_unlock(&wp210_i2c_lock);
+	if (ret != 0) {
+		static int logged;
+		if (logged++ < 8) {
+			printf("SWEET BATTERY: wp210 I2C %#x reg %#x: %s (stat %#x, debug %#x)\n", addr7, w[0],
+			    ret == -2 ? "timeout" : "no ack / arbitration", st, wp210_i2c_rd(I2C_DEBUGSTAT));
+		}
+	}
+	return ret;
+}
+
+static const uint8_t mt6375_bank_addr[6] = {0x4e, 0x34, 0x1a, 0x4a, 0x64, 0x3f};
+
+static int
+mt6375_read(uint16_t reg, uint8_t *buf, int n)
+{
+	unsigned bank = reg >> 8;
+	uint8_t r = (uint8_t)reg;
+	return bank < 6 ? wp210_i2c_xfer(mt6375_bank_addr[bank], &r, 1, buf, n) : -1;
+}
+
+static int
+mt6375_write(uint16_t reg, uint8_t v)
+{
+	unsigned bank = reg >> 8;
+	uint8_t b[2] = {(uint8_t)reg, v};
+	return bank < 6 ? wp210_i2c_xfer(mt6375_bank_addr[bank], b, 2, NULL, 0) : -1;
+}
+
+/* One-shot ADC conversion of channel ch (1..15); the raw big-endian result */
+static int
+mt6375_adc(int ch, uint16_t *raw)
+{
+	uint8_t v = 0, b[2];
+	if (mt6375_write(0x1a6, (uint8_t)(ch << 4)) != 0) {
+		return -1;
+	}
+	delay(4400);
+	for (int i = 0; i < 20; i++) {
+		if (mt6375_read(0x1a6, &v, 1) != 0) {
+			return -1;
+		}
+		if ((v & 0xf0u) == 0) {
+			break;
+		}
+		delay(200);
+	}
+	if ((v & 0xf0u) != 0 || mt6375_read((uint16_t)(0x1aa + 2 * (ch - 1)), b, 2) != 0) {
+		return -1;
+	}
+	*raw = (uint16_t)((b[0] << 8) | b[1]);
+	return 0;
+}
+
+/* battery0_profile_t1 (25 C): capacity used (0.1 mAh) and OCV (0.1 mV), 100 points */
+static const uint32_t wp210_ocv_q[] = {
