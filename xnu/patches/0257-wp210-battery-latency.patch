+
+static unsigned
+wp210_ocv_percent(unsigned mv)
+{
+	const unsigned n = sizeof(wp210_ocv_v) / sizeof(wp210_ocv_v[0]);
+	const uint32_t qmax = wp210_ocv_q[n - 1];
+	uint32_t v = mv * 10u, q;
+	if (v >= wp210_ocv_v[0]) {
+		return 100;
+	}
+	if (v <= wp210_ocv_v[n - 1]) {
+		return 0;
+	}
+	unsigned i = 1;
+	while (i < n - 1 && wp210_ocv_v[i] > v) {
+		i++;
+	}
+	/* between point i - 1 (higher voltage) and i */
+	uint32_t vh = wp210_ocv_v[i - 1], vl = wp210_ocv_v[i];
+	q = wp210_ocv_q[i - 1] + (vh > vl ? (wp210_ocv_q[i] - wp210_ocv_q[i - 1]) * (vh - v) / (vh - vl) : 0);
+	unsigned pct = (unsigned)(100u - (uint64_t)q * 100u / qmax);
+	return pct > 100 ? 100 : pct;
+}
+
+/*
+ * For SweetBattery, every 5 s: 1 measured (mv, ma, percent valid), 0 only
+ * external power known, -1 nothing yet. external: USB power present.
+ */
+int wp210_battery_sample(unsigned *mv, int *ma, unsigned *percent, int *external);
+int
+wp210_battery_sample(unsigned *mv, int *ma, unsigned *percent, int *external)
+{
+	static int on = -1, ok_logged, adc_enabled;
+	static unsigned hist[4], nh;
+	static uint16_t last_raw;
+	uint32_t top = wp210_topstatus;
+	if (on < 0) {
+		on = 1;
+		(void)PE_parse_boot_argn("wp210battery", &on, sizeof(on));
+	}
+	if (!on || top == ~0u) {
+		return -1;
+	}
+	*external = (top & 0x4u) != 0;
+	if (wp210_i2c_init() != 1) {
+		return 0;
+	}
+	uint8_t id = 0, cfg1 = 0, mon[2] = {0, 0};
+	if (!ok_logged) {
+		if (mt6375_read(0x100, &id, 1) != 0) {
+			return 0;
+		}
+		(void)mt6375_read(0x1a4, &cfg1, 1);
+		(void)mt6375_read(0x19c, mon, 2);
+		printf("SWEET BATTERY: wp210 MT6375 dev info %#x (vendor %#x rev %u), ADC CFG1 %#x, VBATMON %#x\n", id,
+		    id & 0xf0u, id & 0x0fu, cfg1, (mon[0] << 8) | mon[1]);
+		ok_logged = 1;
+		if ((id & 0xf0u) != 0x70u) {
+			printf("SWEET BATTERY: wp210 not an MT6375: ADC not used\n");
+			wp210_i2c_state = -1;
+			return 0;
+		}
+		if (!(cfg1 & 0x80u) && !adc_enabled) {
+			adc_enabled = 1;
+			int r = mt6375_write(0x1a4, (uint8_t)(cfg1 | 0x80u));
+			(void)mt6375_read(0x1a4, &cfg1, 1);
+			printf("SWEET BATTERY: wp210 ADC enabled (%d): CFG1 %#x\n", r, cfg1);
+		}
+	}
+	uint16_t vraw = 0, iraw = 0;
+	if (mt6375_adc(4, &vraw) != 0) {
+		return 0;
+	}
+	(void)mt6375_adc(6, &iraw);
+	unsigned v = (unsigned)vraw * 1250u / 1000u;
+	if (v < 2800 || v > 4700) {
+		printf("SWEET BATTERY: wp210 VBAT raw %#x = %u mV: implausible\n", vraw, v);
+		return 0;
+	}
+	hist[nh++ % 4] = v;
+	unsigned cnt = nh < 4 ? nh : 4, sum = 0;
+	for (unsigned k = 0; k < cnt; k++) {
+		sum += hist[k];
+	}
+	*mv = sum / cnt;
+	*ma = (int)((unsigned)iraw * 2500u / 1000u);
+	*percent = wp210_ocv_percent(*mv);
+	if (vraw != last_raw || nh <= 2) {
+		static unsigned n;
+		if (n++ < 400) {
+			printf("SWEET BATTERY: wp210 VBAT raw %#x = %u mV (avg %u), IBAT raw %#x = %d mA, top %#x -> %u%%, "
+			    "external %d\n", vraw, v, *mv, iraw, *ma, top, *percent, *external);
+		}
+		last_raw = vraw;
+	}
+	return 1;
+}
