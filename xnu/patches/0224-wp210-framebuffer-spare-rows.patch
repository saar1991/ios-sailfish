@@ -90,6 +90,13 @@ static uint32_t sweet_fb_vsync_us = 16667;
 #define SWEET_FB_FORMAT_BGRA            0x42475241
 #define SWEET_FB_P1_W                   750     /* Pixel 1: iPhone 8 points @2x */
 #define SWEET_FB_P1_H                   1334
+/*
+ * 0224: spare rows after the 750x1334 buffer. llvmpipe draws in 4x4 blocks
+ * and reads whole blocks at the bottom edge, rows 1332-1335: backboardd
+ * crashed reading row 1335 of this buffer (logs 61934921, 0a58836c: the
+ * mapping of 0x3d4000 bytes ended 1408 bytes after row 1333).
+ */
+#define SWEET_FB_SPARE_ROWS     4
 #define SWEET_FB_P1_DOT_PITCH           326
 
 extern "C" void sweet_fbcon_kick(bool force);           /* pexpert/arm/pe_serial.c */
@@ -432,7 +439,9 @@ AppleCLCD::start(IOService *provider)
 	fLock = IOLockAlloc();
 	fPresentLock = IOLockAlloc();
 	fClients = OSArray::withCapacity(4);
-	fSurface = sweet_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes, SWEET_FB_FORMAT_BGRA);
+	/* 0224: the scaled path's own buffer has spare rows (fShadow); the boot framebuffer has none */
+	fSurface = sweet_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes, SWEET_FB_FORMAT_BGRA,
+	    fScaled ? SWEET_FB_SPARE_ROWS * fRowBytes : 0);
 	fPixels = fSurface != NULL ? fSurface->kernelAddress() : 0;
 	fWorkLoop = IOWorkLoop::workLoop();
 	if (fLock == NULL || fPresentLock == NULL || fClients == NULL || fPixels == 0 || fWorkLoop == NULL) {
@@ -525,7 +534,7 @@ AppleCLCD::startScaled(void)
 	fPanel = ml_io_map_wcomb((vm_offset_t)fPhys, (vm_size_t)fRowBytes * fHeight);
 	fShadow = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
 	    kIODirectionInOut | kIOMemoryPhysicallyContiguous,
-	    round_page(SWEET_FB_P1_STRIDE * SWEET_FB_P1_H), 0xFFFFFFFFFULL & ~(uint64_t)PAGE_MASK);
+	    round_page(SWEET_FB_P1_STRIDE * (SWEET_FB_P1_H + SWEET_FB_SPARE_ROWS)), 0xFFFFFFFFFULL & ~(uint64_t)PAGE_MASK);
 	fRow = (uint8_t *)IOMallocData(SWEET_FB_P1_W * 4);
 	fOut = (uint8_t *)IOMallocData(fPanelW * 4);    /* 3 or 4 bytes a pixel */
 	fXmap = (uint32_t *)IOMallocData(fPanelW * sizeof(uint32_t));
