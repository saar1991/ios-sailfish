diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index 475ce1b..6c29b9f 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -971,10 +971,50 @@ static volatile uint32_t *fbcon_mtk_mutex[2];
 static volatile uint32_t *fbcon_mtk_dsi;
 static uint64_t fbcon_mtk_last;
 
+/*
+ * MediaTek DSI: INTSTA (+0x0c) bit 31 is DSI_BUSY while a frame is being
+ * sent (Linux mtk_dsi.c, mtk_dsi_wait_for_idle). A command-mode frame of
+ * 1080x2412 takes close to the 1/60 s kick spacing; a START while one is
+ * still going restarts the transfer part way through a row, and the panel
+ * shows a band a few rows high with the picture shifted sideways (videos
+ * 14:37, 0:41/0:49/1:10; e38a725 1:49 likely the same).
+ */
+uint64_t sweet_fbcon_stat_busy, sweet_fbcon_stat_busy_timeout;
+
+static bool
+fbcon_mtk_busy(void)
+{
+	return fbcon_mtk_dsi != NULL && (fbcon_mtk_dsi[0x0c / 4] & (1u << 31)) != 0;
+}
+
+/* Until the DSI has sent the frame (at most 25 ms): before writing the panel buffer, and before a START. */
+void sweet_fbcon_wait_idle(void);
+void
+sweet_fbcon_wait_idle(void)
+{
+	if (!fbcon_mtk_busy()) {
+		return;
+	}
+	uint64_t end = mach_absolute_time() + gPEClockFrequencyInfo.timebase_frequency_hz / 40;
+	sweet_fbcon_stat_busy++;
+	while (fbcon_mtk_busy()) {
+		if (mach_absolute_time() > end) {
+			sweet_fbcon_stat_busy_timeout++;
+			return;
+		}
+		delay(100);
+	}
+}
+
 static void
 fbcon_mtk_kick(bool force)
 {
 	uint64_t gap = gPEClockFrequencyInfo.timebase_frequency_hz / 60;
+	if (force) {
+		sweet_fbcon_wait_idle();
+	} else if (fbcon_mtk_busy()) {
+		return;         /* dropped, like a kick inside the 1/60 s window */
+	}
