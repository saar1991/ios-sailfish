+/* wp210 MediaTek bring-up helpers, defined before ufs_take_over_host */
+static bool su_mtk;
+static void mtk_diag(const char *tag);
+
 static void
 dma_sync(uint32_t off, uint32_t len)
 {
@@ -224,6 +228,9 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 		if (now > deadline) {
 			ufs_wr(REG_UTRLCLR, ~1u);
 			printf("SWEET UFS: command 0x%02x timed out\n", cdb[0]);
+			if (su_mtk) {
