+/*
+ * Every 10 s with sweetperf=2: each domain's state, hardware state and the
+ * words after its registers, and the CSRAM words the phone's DT names
+ * (eas_info: thermal limits at CSRAM+0x1208..0x1214, capacity at +0xfa0),
+ * to find what lowers the clocks after boot. A state that no longer holds
+ * the wp210cpumhz index is written again.
+ */
+static void
+wp210_cpufreq_watch(void)
+{
+	char line[400];
+	int m = 0;
+	if (wp210_csram == 0) {
+		return;
+	}
+	for (int d = 0; d < 3; d++) {
+		volatile uint32_t *r = (volatile uint32_t *)(wp210_csram + wp210_cpufreq_dom[d]);
+		uint32_t st = r[0x88 / 4];
+		m += snprintf(line + m, sizeof(line) - m, " d%d state %u hw %#x %#x %#x %#x %#x", d, st, r[0x8c / 4],
+		    r[0x80 / 4], r[0x114 / 4], r[0x118 / 4], r[0x11c / 4]);
+		if (wp210_want[d] >= 0 && st != (uint32_t)wp210_want[d]) {
+			r[0x88 / 4] = (uint32_t)wp210_want[d];
+			__asm__ volatile ("dsb sy" ::: "memory");
+			m += snprintf(line + m, sizeof(line) - m, " (set %d again)", wp210_want[d]);
+		}
+	}
+	volatile uint32_t *cs = (volatile uint32_t *)(wp210_csram + 0xc00);	/* CSRAM base 0x11bc00 */
+	printf("SWEET CPUFREQ:%s | limit %#x %#x %#x %#x cap %#x %#x %#x %#x\n", line,
+	    cs[0x1208 / 4], cs[0x120c / 4], cs[0x1210 / 4], cs[0x1214 / 4],
+	    cs[0xfa0 / 4], cs[0xfa4 / 4], cs[0xfa8 / 4], cs[0xfac / 4]);
+}
+
