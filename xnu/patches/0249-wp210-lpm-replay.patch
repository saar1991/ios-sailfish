+/*
+ * 0249: Android's boot trace past 3.69 s (boot 6e2a1553, androidboot.fastboot.boottrace):
+ * between DVFSRC_INIT (1.11 s) and DVFSRC_START (4.653 s) the kernel's lpm modules
+ * (mtk_lpm_plat_v1, mtk_lpm_dbg) send 45 MTK_SIP_MTK_LPM_CONTROL (0xc2000507) calls
+ * at 4.638-4.646 s: CPU_PM irq-remain list (0xda0000xx/0xda0300xx), SPM_DBG resource
+ * users / DOE resource control / condition block / RC BBLPM (0xda0100xx), SPM
+ * SET_PENDING_IRQ_INIT (0xda020005), VALIDATE_PWR_STATE_CTRL, CPC_COMMAND. The SPM
+ * firmware may not serve the DVFSRC until its resource controller is set up.
+ * wp210dram=3: replay them, in order and with Android's arguments, right before START.
+ */
+static const uint32_t wp210_lpm_calls[45][3] = {
+	{0xda000002, 0x5, 0x0},
