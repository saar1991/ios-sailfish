+};
+static void
+wp210_lpm_replay(void)
+{
+	int bad = 0;
+	for (int i = 0; i < 45; i++) {
+		register uint64_t x0 __asm__("x0") = 0xc2000507ull;
+		register uint64_t x1 __asm__("x1") = wp210_lpm_calls[i][0];
+		register uint64_t x2 __asm__("x2") = wp210_lpm_calls[i][1];
+		register uint64_t x3 __asm__("x3") = wp210_lpm_calls[i][2];
+		register uint64_t x4 __asm__("x4") = 0;
+		__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4) : :
+		    "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14",
+		    "x15", "x16", "x17", "memory");
+		if (x0 != 0) {
+			bad++;
+		}
+		printf("SWEET LPM: %2d %#x %#x %#x -> a0 %#llx a1 %#llx\n", i, wp210_lpm_calls[i][0],
+		    wp210_lpm_calls[i][1], wp210_lpm_calls[i][2], x0, x1);
+	}
+	printf("SWEET LPM: replayed 45 calls, %d returned non-zero\n", bad);
+}
