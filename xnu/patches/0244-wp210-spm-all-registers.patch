+static void
+wp210_spm_all_dump(const char *tag)
+{
+	char line[400];
+	if (wp210_spm == 0) {
+		wp210_spm = ml_io_map(0x1c001000, 0x1000);
+	}
+	for (unsigned i = 0; i < 416; i += 12) {
+		int m = snprintf(line, sizeof(line), "SWEET SPMALL: %s", tag);
+		for (unsigned j = i; j < i + 12 && j < 416; j++) {
+			m += snprintf(line + m, sizeof(line) - m, " %03x=%x", wp210_spm_all[j],
+			    wp210_rd(wp210_spm, wp210_spm_all[j], 0x1000));
+		}
+		printf("%s\n", line);
+	}
+}
