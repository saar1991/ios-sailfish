+/*
+ * 0213: CollectionsPoster's 420f and BGRA images live under a second (log
+ * 1698ab27: gone before the next sample) and never pass the lock traps.
+ * Log their bytes when another process looks one up (backboardd taking the
+ * wallpaper) and when the last user frees one (its final contents).
+ */
+static uint32_t sweet_surf_px_events;
+
+static void
+sweet_surface_px_event(SweetSurface *s, const char *what)
+{
+	char line[200], name[32];
+	if (sweet_surf_px_events >= 150 || !sweet_surface_px_wanted(s) || !sweet_surface_px_line(s, line, sizeof(line))) {
+		return;
+	}
+	sweet_surf_px_events++;
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET PIX: %s %s id %u %ux%u fmt 0x%x bpr %u planes %u:%s\n", name, what, s->id, s->width, s->height,
+	    s->pixelFormat, s->bytesPerRow, s->planeCount, line);
+}
+
