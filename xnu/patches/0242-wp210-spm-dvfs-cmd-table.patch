+/*
+ * 0242: the SPM's DVFS side with the offsets the vendor debug driver uses
+ * for mt6983/mt6895 (mt6877_spm_regs): command table SPM_DVFS_CMD0-23
+ * 0x310-0x36c, SPM_DVFS_STA 0x388, SPM_DVFS_LEVEL 0x38c, SPM_DVS_DFS_LEVEL
+ * 0x390, PC 0x194, SW_FLAG 0x600/0x608. Android idle (dvfsrc_dump): flag
+ * 0x02190067, level 2, dvs_dfs 0x10080, CMD0-4 0x024e0058 0x024e005c ...
+ */
+static void
+wp210_spm_cmds(const char *tag)
+{
+	char line[400];
+	if (wp210_spm == 0) {
+		wp210_spm = ml_io_map(0x1c001000, 0x1000);
+	}
+	printf("SWEET SPMCMD: %s pc %#x flag0 %#x flag1 %#x sta %#x level %#x dvs_dfs %#x\n", tag,
+	    wp210_rd(wp210_spm, 0x194, 0x1000), wp210_rd(wp210_spm, 0x600, 0x1000), wp210_rd(wp210_spm, 0x608, 0x1000),
+	    wp210_rd(wp210_spm, 0x388, 0x1000), wp210_rd(wp210_spm, 0x38c, 0x1000), wp210_rd(wp210_spm, 0x390, 0x1000));
+	for (int h = 0; h < 2; h++) {
+		int m = snprintf(line, sizeof(line), "SWEET SPMCMD: %s cmd%d-%d", tag, h * 12, h * 12 + 11);
+		for (int i = h * 12; i < h * 12 + 12; i++) {
+			m += snprintf(line + m, sizeof(line) - m, " %x", wp210_rd(wp210_spm, 0x310 + i * 4, 0x1000));
+		}
+		printf("%s\n", line);
+	}
+}
