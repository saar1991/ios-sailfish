+/*
+ * 0211: the boot wallpaper is magenta for 2 s (video 16:45) with red = blue
+ * in every spot, as if the Cb,Cr,Cb,Cr bytes of a 420f image's second plane
+ * were shown as B,G,R,A. For the first unlock of each large image, log 4
+ * bytes at the middle column, a quarter, half and three quarters down, of
+ * every plane. (Log ec3478a8: CollectionsPoster's images never come here;
+ * backboardd's 1105x1160 copy was all zero at its first unlock.)
+ */
+static void
+sweet_surface_log_pixels(SweetSurface *s, bool write)
+{
+	if (!sweet_surface_px_wanted(s)) {
+		return;
+	}
+	IOLockLock(sweet_surface_lock);
+	bool seen = sweet_surf_px_n >= 48;
+	for (uint32_t i = 0; i < sweet_surf_px_n && !seen; i++) {
+		seen = sweet_surf_px_ids[i] == s->id;
+	}
+	if (!seen) {
+		sweet_surf_px_ids[sweet_surf_px_n++] = s->id;
+	}
+	IOLockUnlock(sweet_surface_lock);
+	char line[200], name[32];
+	if (seen || !sweet_surface_px_line(s, line, sizeof(line))) {
+		return;
+	}
 	proc_selfname(name, sizeof(name));
 	IOLog("SWEET PIX: %s %s id %u %ux%u fmt 0x%x bpe %u bpr %u:%s\n", name, write ? "wrote" : "read", s->id,
-	    s->width, s->height, f, s->bytesPerElement, s->bytesPerRow, line);
+	    s->width, s->height, s->pixelFormat, s->bytesPerElement, s->bytesPerRow, line);
+}
+
+/*
+ * 0212: the same bytes for every large image, sampled by the kernel itself
+ * (from the perf thread, once a second while the system starts), logged
+ * when they change: which image turns magenta, and when, whoever writes it.
+ */
+static uint32_t sweet_surf_px_hash[SWEET_SURFACE_MAX_ID];
+static uintptr_t sweet_surf_px_obj[SWEET_SURFACE_MAX_ID];
+static uint32_t sweet_surf_px_lines;
+
+extern "C" void sweet_surface_sample(uint64_t up);
+void
+sweet_surface_sample(uint64_t up)
+{
+	for (uint32_t id = 1; id < SWEET_SURFACE_MAX_ID && sweet_surf_px_lines < 300; id++) {
+		SweetSurface *s = sweet_surface_copy(id);
+		if (s == NULL) {
+			continue;
+		}
+		char line[200];
+		if (sweet_surface_px_wanted(s) && sweet_surface_px_line(s, line, sizeof(line))) {
+			uint32_t h = 2166136261u;
+			for (const char *c = line; *c; c++) {
+				h = (h ^ (uint8_t)*c) * 16777619u;
+			}
+			if (sweet_surf_px_obj[id] != (uintptr_t)s || sweet_surf_px_hash[id] != h) {
+				sweet_surf_px_obj[id] = (uintptr_t)s;
+				sweet_surf_px_hash[id] = h;
+				sweet_surf_px_lines++;
+				IOLog("SWEET PIX: %llu s id %u %ux%u fmt 0x%x bpr %u:%s\n", (unsigned long long)up, id, s->width, s->height,
+				    s->pixelFormat, s->bytesPerRow, line);
+			}
+		}
+		s->release();
+	}
 }
 
