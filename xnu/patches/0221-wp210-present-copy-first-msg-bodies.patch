 void
 AppleCLCD::swap(const uint8_t *rec)
 {
 	IOLockLock(fLock);
+	uint32_t id = get32(rec, 0x54);
+	if (fStageOn && fReading != 0 && fReading != id) {
+		/* backboardd will draw into fReading next: let the presenter finish reading it */
+		uint64_t t0 = mach_absolute_time(), deadline;
+		clock_interval_to_deadline(50, NSEC_PER_MSEC, &deadline);
+		while (fReading != 0 && fReading != id) {
+			if (IOLockSleepDeadline(fLock, &fReading, deadline, THREAD_UNINT) == THREAD_TIMED_OUT) {
+				sweet_fb_stat_swap_wait_timeouts++;
+				break;
+			}
+		}
+		uint64_t d = mach_absolute_time() - t0;
+		sweet_fb_stat_swap_waits++;
+		sweet_fb_stat_swap_wait_abs += d;
+		if (d > sweet_fb_stat_swap_wait_max) {
+			sweet_fb_stat_swap_wait_max = d;
+		}
+	}
 	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
