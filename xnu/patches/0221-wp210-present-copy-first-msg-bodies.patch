+/*
+ * 0221 (log 92a99cec): launchd gets id 0x40000324 from mediaserverd ~4,700
+ * times a second and answers with 0x20000000. What does mediaserverd ask
+ * for? The first 4 messages each way between the two sweetsys processes,
+ * from 20 s on: size, descriptors, the printable strings in the body (XPC
+ * keys and values, e.g. a service name) and the first 96 bytes in hex.
+ */
+void sweet_sys_body(int which, uint32_t id, int pid, const uint8_t *data, uint32_t len, uint32_t ndesc, uint32_t bits);
+void
+sweet_sys_body(int which, uint32_t id, int pid, const uint8_t *data, uint32_t len, uint32_t ndesc, uint32_t bits)
+{
+	static uint32_t shown[2];
+	if (pid == 0 || pid != sweet_sys_pid[1 - which] || shown[which] >= 4 || data == NULL) {
+		return;
+	}
+	uint64_t up;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &up);
+	up /= NSEC_PER_SEC;
+	if (up < 20) {
+		return;
+	}
+	shown[which]++;
+	if (len > 4096) {
+		len = 4096;
+	}
+	char str[300];
+	int m = 0;
+	for (uint32_t i = 0; i < len && m < (int)sizeof(str) - 2;) {
+		uint32_t j = i;
+		while (j < len && data[j] >= 0x20 && data[j] < 0x7f) {
+			j++;
+		}
+		if (j - i >= 4) {
+			if (m != 0) {
+				str[m++] = '|';
+			}
+			for (uint32_t k = i; k < j && m < (int)sizeof(str) - 2; k++) {
+				str[m++] = (char)data[k];
+			}
+		}
+		i = j + 1;
+	}
+	str[m] = 0;
+	printf("SWEET MSG: %llu s %s[%d] got %#x from %s[%d]: %u bytes, %u descriptors, bits %#x, strings: %s\n",
+	    (unsigned long long)up, sweet_sys_name[which], sweet_sys_pid[which], id, sweet_sys_name[1 - which], pid,
+	    len, ndesc, bits, m ? str : "(none)");
+	char hex[3 * 96 + 1];
+	uint32_t n = len < 96 ? len : 96;
+	for (uint32_t i = 0; i < n; i++) {
+		snprintf(hex + 3 * i, 4, "%02x ", data[i]);
+	}
+	hex[n ? 3 * n - 1 : 0] = 0;
+	printf("SWEET MSG: hex %s\n", hex);
+}
