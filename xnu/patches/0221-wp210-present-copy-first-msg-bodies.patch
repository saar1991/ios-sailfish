+/* 0221: the presenter no longer reads the swapped surface; a waiting swap goes on. */
+void
+AppleCLCD::doneReading(void)
+{
+	IOLockLock(fLock);
+	if (fReading != 0) {
+		fReading = 0;
+		IOLockWakeup(fLock, &fReading, false);
+	}
+	IOLockUnlock(fLock);
+}
+
+/*
+ * 0221: copy rows 0..sy+h of a surface into fStage and stop reading the
+ * surface. Returns the copy, or src when there is no room (the surface is
+ * then read directly, and swaps wait until the panel copy is done).
+ */
+uintptr_t
+AppleCLCD::stage(uintptr_t src, uint32_t bpr, int32_t sy, int32_t h)
+{
+	size_t len = (size_t)(sy + h) * bpr;
+	if (!fStageOn || len == 0) {
+		return src;
+	}
+	if (len > fStageSize) {
+		if (fStage != NULL) {
+			IOFreeData(fStage, fStageSize);
+		}
+		fStage = (uint8_t *)IOMallocData(len);
+		fStageSize = fStage != NULL ? len : 0;
+		IOLog("SWEET FB: stage buffer %zu bytes%s\n", len, fStage != NULL ? "" : " not allocated");
+		if (fStage == NULL) {
+			return src;
+		}
+	}
+	uint64_t t0 = mach_absolute_time();
+	memcpy(fStage, (const void *)src, len);
+	uint64_t d = mach_absolute_time() - t0;
+	sweet_fb_stat_staged++;
+	sweet_fb_stat_stage_abs += d;
+	if (d > sweet_fb_stat_stage_max) {
+		sweet_fb_stat_stage_max = d;
+	}
+	doneReading();
+	return (uintptr_t)fStage;
+}
