diff --git a/bsd/dev/sweet_perf.c b/bsd/dev/sweet_perf.c
index 0b52077..1ade02f 100644
--- a/bsd/dev/sweet_perf.c
+++ b/bsd/dev/sweet_perf.c
@@ -944,6 +944,80 @@ wp210_cpufreq_watch(void)
 
 #define PERF_SAFE_CPUS 8
 
+/*
+ * 0226: the clock tree behind the halving. The phone's DT (cpuhvfs@114400,
+ * "mediatek,cpufreq-hybrid") names the CPU PLLs' CON1 registers in
+ * apmixedsys (0x1000c000 + 0x20c LL = A55s, 0x21c BL = A78s, 0x22c B =
+ * prime, 0x23c CCI) and the clock dividers after them in mcusys_ao_cfg
+ * (0x0c530000 + 0xa2a0 / 0xa2a4 / 0xa2a8 / 0xa2e0). CON1: posdiv in bits
+ * 26:24 (1 << n), PCW in 21:0 with 14 fraction bits of 26 MHz. Divider:
+ * ckdiv1 in bits 21:17 (8 = /1, 10 = /2, 11 = /4). Logged once a second
+ * (with SWEET MHZ) whenever a word changed, so the line before and after
+ * the drop at ~41 s shows which one moved. wp210lldiv=1: when the A55
+ * divider leaves the value it had at the first sample, write that value
+ * back (logged; at most 20 times).
+ */
+#define WP210_APMIXED_PA        0x1000c000u
+#define WP210_CLKDIV_PA         0x0c53a000u
+static const uint32_t wp210_pll_con1[4] = {0x20c, 0x21c, 0x22c, 0x23c};
+static const uint32_t wp210_clkdiv[4] = {0x2a0, 0x2a4, 0x2a8, 0x2e0};    /* in the 0x0c53a000 page */
+static vm_offset_t wp210_apmixed, wp210_div;
+
+static uint32_t
+wp210_pll_mhz(uint32_t con1)
+{
+	uint64_t pcw = con1 & 0x3fffff;
+	unsigned post = (con1 >> 24) & 7;
+	return (uint32_t)((26ull * pcw >> 14) >> post);
+}
+
+static void
+wp210_clktree(uint64_t up)
+{
+	static uint32_t last[12], first_div = 0xffffffff;
+	static int seen, fixes, fix = -1;
+	if (fix < 0) {
+		fix = 0;
+		(void)PE_parse_boot_argn("wp210lldiv", &fix, sizeof(fix));
+		wp210_apmixed = ml_io_map(WP210_APMIXED_PA, 0x1000);
+		wp210_div = ml_io_map(WP210_CLKDIV_PA, 0x1000);
+		printf("SWEET CLKTREE: apmixedsys %s, mcusys divider page %s, wp210lldiv=%d\n",
+		    wp210_apmixed ? "mapped" : "NOT mapped", wp210_div ? "mapped" : "NOT mapped", fix);
+	}
+	if (wp210_apmixed == 0 || wp210_div == 0) {
+		return;
+	}
+	uint32_t w[12];
+	for (int i = 0; i < 4; i++) {
+		w[i * 2] = *(volatile uint32_t *)(wp210_apmixed + wp210_pll_con1[i] - 4);     /* CON0 */
+		w[i * 2 + 1] = *(volatile uint32_t *)(wp210_apmixed + wp210_pll_con1[i]);     /* CON1 */
+		w[8 + i] = *(volatile uint32_t *)(wp210_div + wp210_clkdiv[i]);
+	}
+	if (first_div == 0xffffffff) {
+		first_div = w[8];
+	}
+	if (!seen || memcmp(w, last, sizeof(w)) != 0) {
+		static const char *const n[4] = {"LL", "BL", "B", "CCI"};
+		char line[400];
+		int m = snprintf(line, sizeof(line), "SWEET CLKTREE: %llu s", (unsigned long long)up);
+		for (int i = 0; i < 4; i++) {
+			m += snprintf(line + m, sizeof(line) - m, " | %s pll %#x %#x = %u MHz div %#x (ckdiv %u)", n[i],
+			    w[i * 2], w[i * 2 + 1], wp210_pll_mhz(w[i * 2 + 1]), w[8 + i], (w[8 + i] >> 17) & 0x1f);
+		}
+		printf("%s\n", line);
+		memcpy(last, w, sizeof(w));
+		seen = 1;
+	}
+	if (fix == 1 && w[8] != first_div && fixes < 20) {
+		fixes++;
+		*(volatile uint32_t *)(wp210_div + wp210_clkdiv[0]) = first_div;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		delay(100);
+		printf("SWEET CLKTREE: %llu s LL divider %#x -> wrote back %#x, reads %#x (fix %d)\n",
+		    (unsigned long long)up, w[8], first_div, *(volatile uint32_t *)(wp210_div + wp210_clkdiv[0]), fixes);
+	}
+}
+
 /*
  * sweetperf=2: every CPU's clock once a second for the first 150 s after
  * boot, with the cpufreq state of each domain. The CPUs XNU numbers 0-3
@@ -982,6 +1056,7 @@ wp210_mhz_fast(void *arg, wait_result_t result)
 		for (int d = 0; d < 3 && wp210_csram != 0; d++) {
 			st[d] = ((volatile uint32_t *)(wp210_csram + wp210_cpufreq_dom[d]))[0x88 / 4];
 		}
+		wp210_clktree(up);
 		if (up <= 150) {
 			printf("SWEET MHZ: %llu s %llu/%llu/%llu/%llu/%llu/%llu/%llu/%llu state %u/%u/%u\n",
 			    (unsigned long long)up, (unsigned long long)mhz[0], (unsigned long long)mhz[1],
