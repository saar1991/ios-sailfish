diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 55dde01..692c95b 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -385,6 +385,235 @@ wp210_tp_probe(int level)
 	printf("WP210 TP: probe done\n");
 }
 
+/*
+ * WP210 touch bring-up, round 2: boot-arg wp210tp=1 powers the Goodix
+ * GT9916P (Berlin-D) up and reads its identity over SPI2. No touch events
+ * yet. Every value below was read from this phone under Android:
+ *   AVDD enable GPIO 90, IOVDD enable GPIO 91 (high = on), reset GPIO 3
+ *   (high = running), IRQ GPIO 135 (idle high), SPI2 pads GPIO 109..112
+ *   function 1; spi clock mux = topckgen 0x0c0 bits 8..15 (bit 15 = off),
+ *   spi2 gate = pericfg_ao 0x040 bit 5 (1 = off); both only open during a
+ *   transfer under Android. MUX/gate set and clear registers are +4 / +8.
+ * SPI2 is a MediaTek "mt65xx" controller used in polled FIFO mode (32 bytes
+ * a transfer at most, no interrupt, no DMA), mode 0, MSB first.
+ * Goodix read: F1, 4 address bytes (big endian), 4 dummy bytes, then data.
+ */
+#define WP210_TOPCK_PA   0x10000000u
+#define WP210_PERAO_PA   0x11036000u
+#define WP210_SPI2_PA    0x11012000u
+#define WP210_TP_RST     3u
+#define WP210_TP_AVDD    90u
+#define WP210_TP_IOVDD   91u
+#define WP210_TP_IRQ     135u
+
+static vm_offset_t wp210_topck, wp210_perao, wp210_spi;
+
+static void
+wp210_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+wp210_gpio_field(uint32_t off, uint32_t shift, uint32_t mask, uint32_t v)
+{
+	wp210_wr(wp210_gpio, off, (keys_rd(wp210_gpio, off) & ~(mask << shift)) | (v << shift));
+}
+
+static void
+wp210_gpio_mode(uint32_t pin, uint32_t mode)
+{
+	wp210_gpio_field(0x300u + 0x10u * (pin / 8u), 4u * (pin % 8u), 0xfu, mode);
+}
+
+static void
+wp210_gpio_out(uint32_t pin, uint32_t level)
+{
+	wp210_gpio_field(0x100u + 0x10u * (pin / 32u), pin % 32u, 1u, level);
+	wp210_gpio_field(0x10u * (pin / 32u), pin % 32u, 1u, 1u);
+}
+
+/* One full-duplex FIFO transfer, len 1..32. */
+static bool
+wp210_spi_xfer(const uint8_t *tx, uint8_t *rx, uint32_t len)
+{
+	uint32_t cmd = (1u << 11) | (1u << 12);        /* TX/RX MSB first */
+	wp210_wr(wp210_spi, 0x18, cmd | (1u << 2));    /* reset */
+	wp210_wr(wp210_spi, 0x18, cmd);
+	wp210_wr(wp210_spi, 0x24, 0);                  /* pad select 0 */
+	wp210_wr(wp210_spi, 0x00, 207u | (207u << 16));  /* CS hold, setup */
+	wp210_wr(wp210_spi, 0x28, 103u | (103u << 16));  /* SCK high, low */
+	wp210_wr(wp210_spi, 0x04, 0xffu | ((len - 1u) << 16));
+	for (uint32_t i = 0; i < len; i += 4) {
+		uint32_t w = 0;
+		for (uint32_t b = 0; b < 4 && i + b < len; ++b) {
+			w |= (uint32_t)tx[i + b] << (8u * b);
+		}
+		wp210_wr(wp210_spi, 0x10, w);
+	}
+	wp210_wr(wp210_spi, 0x18, cmd | 1u);           /* activate */
+	delay(20);
+	unsigned t;
+	for (t = 0; t < 20000 && !(keys_rd(wp210_spi, 0x20) & 1u); ++t) {
+		delay(10);
+	}
+	if (t == 20000) {
+		printf("WP210 TP: spi timeout status0=%#x status1=%#x cmd=%#x\n",
+		    keys_rd(wp210_spi, 0x1c), keys_rd(wp210_spi, 0x20), keys_rd(wp210_spi, 0x18));
+		return false;
+	}
+	for (uint32_t i = 0; i < len; i += 4) {
+		uint32_t w = keys_rd(wp210_spi, 0x14);
+		for (uint32_t b = 0; b < 4 && i + b < len; ++b) {
+			rx[i + b] = (uint8_t)(w >> (8u * b));
+		}
+	}
+	(void)keys_rd(wp210_spi, 0x1c);
+	return true;
+}
+
+static bool
+wp210_tp_read(uint32_t addr, uint8_t *out, uint32_t n)
+{
+	uint8_t tx[32], rx[32];
+	if (n == 0 || n > 23) {
+		return false;
+	}
+	memset(tx, 0xff, sizeof(tx));
+	tx[0] = 0xf1;
+	tx[1] = (uint8_t)(addr >> 24);
+	tx[2] = (uint8_t)(addr >> 16);
+	tx[3] = (uint8_t)(addr >> 8);
+	tx[4] = (uint8_t)addr;
+	if (!wp210_spi_xfer(tx, rx, 9u + n)) {
+		return false;
+	}
+	memcpy(out, rx + 9, n);
+	return true;
+}
+
+static void
+wp210_tp_hex(const char *what, uint32_t addr, const uint8_t *b, uint32_t n)
+{
+	char line[3 * 23 + 1];
+	for (uint32_t i = 0; i < n; ++i) {
+		snprintf(line + 3 * i, 4, "%02x ", b[i]);
+	}
+	printf("WP210 TP: %s %#x: %s\n", what, addr, line);
+}
+
+static void
+wp210_tp_thread(void *arg, wait_result_t result)
+{
+	uint8_t id[22];
+	(void)arg;
+	(void)result;
+	wp210_tp_probe(1);
+
+	/* Power: reset held low, IOVDD, AVDD, release reset (Android: 130 ms). */
+	wp210_gpio_mode(WP210_TP_RST, 0);
+	wp210_gpio_mode(WP210_TP_AVDD, 0);
+	wp210_gpio_mode(WP210_TP_IOVDD, 0);
+	wp210_gpio_mode(WP210_TP_IRQ, 0);
+	wp210_gpio_field(0x10u * (WP210_TP_IRQ / 32u), WP210_TP_IRQ % 32u, 1u, 0u);
+	wp210_gpio_out(WP210_TP_RST, 0);
+	wp210_gpio_out(WP210_TP_IOVDD, 1);
+	delay(3000);
+	wp210_gpio_out(WP210_TP_AVDD, 1);
+	delay(15000);
+	wp210_gpio_out(WP210_TP_RST, 1);
+	for (uint32_t p = 109; p <= 112; ++p) {
+		wp210_gpio_mode(p, 1);
+	}
+	/* Clocks: open the spi mux and the spi2 gate. */
+	wp210_wr(wp210_topck, 0x0c8, 1u << 15);
+	wp210_wr(wp210_perao, 0x048, 1u << 5);
+	delay(100);
+	if (keys_rd(wp210_perao, 0x040) & (1u << 5)) {
+		printf("WP210 TP: gate clear register had no effect; writing 0x040 directly\n");
+		wp210_wr(wp210_perao, 0x040, keys_rd(wp210_perao, 0x040) & ~(1u << 5));
+	}
+	printf("WP210 TP: clocks topckgen+0c0=%08x pericfg_ao+040=%08x\n",
+	    keys_rd(wp210_topck, 0x0c0), keys_rd(wp210_perao, 0x040));
+	if ((keys_rd(wp210_perao, 0x040) & (1u << 5)) || (keys_rd(wp210_topck, 0x0c0) & (1u << 15))) {
+		printf("WP210 TP: spi clock did not open; stopping before touching SPI2\n");
+		return;
+	}
+	wp210_tp_dump("spi2", WP210_SPI2_PA, 20);
+	for (int k = 0; k < 8; ++k) {       /* 160 ms for the chip to boot */
+		keys_wait();
+	}
+	wp210_tp_probe(1);
+
+	for (int tries = 0; tries < 3; ++tries) {
+		memset(id, 0, sizeof(id));
+		if (wp210_tp_read(0x10014u, id, sizeof(id))) {
+			wp210_tp_hex("version", 0x10014u, id, sizeof(id));
+			if (memcmp(id, "BERLIN", 6) == 0) {
+				printf("WP210 TP: Goodix answered: rom %.6s patch %.8s vid %02x%02x%02x%02x (Android: 9916P 0c800306)\n",
+				    (const char *)id, (const char *)id + 10, id[18], id[19], id[20], id[21]);
+				break;
+			}
+		}
+		for (int k = 0; k < 5; ++k) {
+			keys_wait();
+		}
+	}
+	if (memcmp(id, "BERLIN", 6) != 0) {
+		printf("WP210 TP: no valid answer from the touch controller\n");
+	} else {
+		/* IC info block: 16-bit length, then the layout (touch data address etc). */
+		uint8_t len2[2] = {0, 0};
+		if (wp210_tp_read(0x10070u, len2, 2)) {
+			uint32_t total = len2[0] | ((uint32_t)len2[1] << 8);
+			printf("WP210 TP: ic info length %u\n", total);
+			if (total > 506) {
+				total = 506;
+			}
+			for (uint32_t off = 0; off < total; off += 23) {
+				uint8_t b[23];
+				uint32_t n = total - off < 23 ? total - off : 23;
+				if (!wp210_tp_read(0x10070u + off, b, n)) {
+					break;
+				}
+				wp210_tp_hex("icinfo", 0x10070u + off, b, n);
+			}
+		}
+	}
+	/* Watch the interrupt line for a minute: touch the screen now. */
+	int last = -1, prints = 0;
+	for (int i = 0; i < 3000 && prints < 40; ++i) {
+		int now = wp210_pin(WP210_TP_IRQ);
+		if (now != last) {
+			printf("WP210 TP: irq line %d (sample %d)\n", now, i);
+			last = now;
+			prints++;
+		}
+		keys_wait();
+	}
+	printf("WP210 TP: round 2 done\n");
+}
+
+static void
+wp210_tp_start(void)
+{
+	thread_t thread;
+	if (wp210_gpio == 0) {
+		wp210_gpio = ml_io_map(WP210_GPIO_PA, 0x1000);
+	}
+	wp210_topck = ml_io_map(WP210_TOPCK_PA, 0x1000);
+	wp210_perao = ml_io_map(WP210_PERAO_PA, 0x1000);
+	wp210_spi = ml_io_map(WP210_SPI2_PA, 0x1000);
+	if (!wp210_gpio || !wp210_topck || !wp210_perao || !wp210_spi) {
+		printf("WP210 TP: MMIO mapping failed\n");
+		return;
+	}
+	if (kernel_thread_start(wp210_tp_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 void
 sweet_keys_init(void)
 {
@@ -403,6 +632,11 @@ sweet_keys_init(void)
 		if (tpprobe) {
 			wp210_tp_probe(tpprobe);
 		}
+		int tp = 0;
+		(void)PE_parse_boot_argn("wp210tp", &tp, sizeof(tp));
+		if (tp) {
+			wp210_tp_start();
+		}
 		return;
 	}
 	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
