+/* 0256: one line per engine: the addresses it reads and which LK buffer each falls in */
+void sweet_fbcon_scan_report(void);
+void
+sweet_fbcon_scan_report(void)
+{
+	static const char *const name[4] = {"ovl0", "ovl1", "rdma0", "rdma1"};
+	if (fbcon_phys == 0) {
+		return;
+	}
+	printf("SWEET SCAN: LK buffers at %#llx, stride %#llx, %u buffers; writing %s\n",
+	    (unsigned long long)fbcon_phys, (unsigned long long)fbcon_buf_stride, fbcon_nbuf,
+	    fbcon_only_buf < 0 ? "all" : fbcon_only_buf == 0 ? "buffer 0" : fbcon_only_buf == 1 ? "buffer 1" : "buffer 2");
+	for (int e = 0; e < 4; e++) {
+		volatile uint32_t *r = fbcon_scan_pages[e];
+		if (r == NULL) {
+			continue;
+		}
+		char line[256];
+		int m = snprintf(line, sizeof(line), "SWEET SCAN: %s", name[e]);
+		int n = e < 2 ? 4 : 1;
+		for (int l = 0; l < n; l++) {
+			uint64_t a = e < 2 ? ((uint64_t)r[(0xf4c + 0x20 * l) / 4] << 32 | r[(0xf40 + 0x20 * l) / 4])
+			    : ((uint64_t)r[0xf10 / 4] << 32 | r[0xf00 / 4]);
+			int b = -1;
+			if (a >= fbcon_phys && fbcon_buf_stride && a < fbcon_phys + fbcon_buf_stride * fbcon_nbuf) {
+				b = (int)((a - fbcon_phys) / fbcon_buf_stride);
+			}
+			if (b >= 0) {
+				m += snprintf(line + m, sizeof(line) - m, " %s%d %#llx (buffer %d)", e < 2 ? "L" : "", l,
+				    (unsigned long long)a, b);
+			} else {
+				m += snprintf(line + m, sizeof(line) - m, " %s%d %#llx", e < 2 ? "L" : "", l,
+				    (unsigned long long)a);
+			}
+		}
+		snprintf(line + m, sizeof(line) - m, " | en %#x", r[e < 2 ? 0x0c / 4 : 0x10 / 4]);
+		printf("%s\n", line);
+	}
+}
