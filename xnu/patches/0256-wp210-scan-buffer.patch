+ * 0256: which buffer does the panel scan? The display engines read their source from
+ * OVL layer address registers (mtk_disp_ovl.c: layer n at 0xf40 + 0x20 n, MSB at 0xf4c +
+ * 0x20 n) or RDMA MEM_START_ADDR 0xf00 / MSB 0xf10. OVL0 0x14002000, OVL1 0x14402000
+ * (second pipe), RDMA0 0x14006000, RDMA1 0x1401c000 (device tree aliases). Read only.
+ */
+static uint64_t fbcon_phys;
