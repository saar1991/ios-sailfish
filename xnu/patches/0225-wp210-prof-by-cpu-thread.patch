+/*
+ * 0225: which CPU the profiled process's samples land on, per thread (the
+ * first SWEET_PROF_THREADS threads seen in a round; the rest count as one).
+ * cpu0 is the A55 at 999 MHz, cpu1-4 the A78s (cpus=5 big-first).
+ */
+#define SWEET_PROF_THREADS 24
+#define SWEET_PROF_CPUS 8
+uint64_t sweet_prof_tid[SWEET_PROF_THREADS + 1];
+uint32_t sweet_prof_tcpu[SWEET_PROF_THREADS + 1][SWEET_PROF_CPUS];
+
+static inline void
+sweet_prof_where(void)
+{
+	uint64_t tid = thread_tid(current_thread());
+	int cpu = cpu_number();
+	int slot = SWEET_PROF_THREADS;
+	if (cpu < 0 || cpu >= SWEET_PROF_CPUS || tid == 0) {
+		return;
+	}
+	for (int i = 0; i < SWEET_PROF_THREADS; i++) {
+		uint64_t t = os_atomic_load(&sweet_prof_tid[i], relaxed);
+		if (t == tid) {
+			slot = i;
+			break;
+		}
+		if (t == 0 && os_atomic_cmpxchg(&sweet_prof_tid[i], 0, tid, relaxed)) {
+			slot = i;
+			break;
+		}
+		if (os_atomic_load(&sweet_prof_tid[i], relaxed) == tid) {
+			slot = i;
+			break;
+		}
+	}
+	os_atomic_inc(&sweet_prof_tcpu[slot][cpu], relaxed);
+}
+
+/* 0225: name of the task's thread tid ("-" unnamed), "" if it is gone */
+extern void bsd_getthreadname(void *uth, char *buffer);
+void sweet_prof_task_thread_name(task_t task, uint64_t tid, char *name, size_t size);
+void
+sweet_prof_task_thread_name(task_t task, uint64_t tid, char *name, size_t size)
+{
+	thread_t th;
+	name[0] = 0;
+	task_lock(task);
+	queue_iterate(&task->threads, th, thread_t, task_threads) {
+		if (thread_tid(th) == tid) {
+			char buf[64];
+			buf[0] = 0;
+			void *ut = get_bsdthread_info(th);
+			if (ut != NULL) {
+				bsd_getthreadname(ut, buf);
+			}
+			strlcpy(name, buf[0] ? buf : "-", size);
+			break;
+		}
+	}
+	task_unlock(task);
+}
