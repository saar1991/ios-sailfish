+/*
+ * 0225: the round's samples by CPU, then per thread (busiest 10): total and
+ * by CPU, with the thread's name (pthread_setname_np) when it still runs.
+ */
+#define SWEET_PROF_THREADS 24
+#define SWEET_PROF_CPUS 8
+extern uint64_t sweet_prof_tid[SWEET_PROF_THREADS + 1];
+extern uint32_t sweet_prof_tcpu[SWEET_PROF_THREADS + 1][SWEET_PROF_CPUS];
+
+extern void sweet_prof_task_thread_name(task_t task, uint64_t tid, char *name, size_t size); /* osfmk/arm64/sleh.c */
+
+static void
+sweet_prof_thread_name(int pid, uint64_t tid, char *name, size_t size)
+{
+	name[0] = 0;
+	proc_t p = proc_find(pid);
+	if (p == PROC_NULL) {
+		return;
+	}
+	task_t task = proc_task(p);
+	if (task != TASK_NULL) {
+		sweet_prof_task_thread_name(task, tid, name, size);
+	}
+	proc_rele(p);
+}
+
+static void
+sweet_prof_print_cpus(int pid, int round)
+{
+	uint64_t tid[SWEET_PROF_THREADS + 1];
+	uint32_t c[SWEET_PROF_THREADS + 1][SWEET_PROF_CPUS], tot[SWEET_PROF_THREADS + 1], all[SWEET_PROF_CPUS] = {0};
+	for (int i = 0; i <= SWEET_PROF_THREADS; i++) {
+		tid[i] = sweet_prof_tid[i];
+		tot[i] = 0;
+		for (int j = 0; j < SWEET_PROF_CPUS; j++) {
+			c[i][j] = sweet_prof_tcpu[i][j];
+			sweet_prof_tcpu[i][j] = 0;
+			tot[i] += c[i][j];
+			all[j] += c[i][j];
+		}
+		sweet_prof_tid[i] = 0;
+	}
+	printf("PROF round %d by cpu: %u %u %u %u %u %u %u %u\n", round,
+	    all[0], all[1], all[2], all[3], all[4], all[5], all[6], all[7]);
+	for (int k = 0; k < 10; k++) {
+		int best = -1;
+		for (int i = 0; i <= SWEET_PROF_THREADS; i++) {
+			if (tot[i] != 0 && (best < 0 || tot[i] > tot[best])) {
+				best = i;
+			}
+		}
+		if (best < 0) {
+			break;
+		}
+		char name[64];
+		if (best < SWEET_PROF_THREADS) {
+			sweet_prof_thread_name(pid, tid[best], name, sizeof(name));
+		} else {
+			strlcpy(name, "(other threads)", sizeof(name));
+		}
+		printf("PROF round %d thread %llu %s: %u, by cpu %u %u %u %u %u %u %u %u\n", round,
+		    tid[best], name[0] ? name : "(gone)", tot[best], c[best][0], c[best][1], c[best][2],
+		    c[best][3], c[best][4], c[best][5], c[best][6], c[best][7]);
+		tot[best] = 0;
+	}
+}
